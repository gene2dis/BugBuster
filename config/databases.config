params {
    bowtie_ref_host_index {
	'human' {
	    title = "T2T-CHM13v2.0"
	    url = [ "https://s3-us-west-2.amazonaws.com/human-pangenomics/T2T/CHM13/assemblies/analysis_set/chm13v2.0.fa.gz" ]
	    dbversion = "T2T-CHM13v2.0 analysis set (https://doi.org/10.1126/science.abj6987)"
	}
    }
    bowtie_ref_genomes_for_build {
	'phiX174' {
            title = "phiX genome"
            url = [ "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/819/615/GCF_000819615.1_ViralProj14015/GCF_000819615.1_ViralProj14015_genomic.fna.gz" ]
            dbversion = "Escherichia phage phiX174, complete genome  (https://www.ncbi.nlm.nih.gov/nuccore/NC_001422.1?report=genbank)"
	}
    }
    sourmash_ref_db {
	'gtdb_220_k31' {
            title = "GTDB reps k31 release 220"
            url = [ "https://farm.cse.ucdavis.edu/~ctbrown/sourmash-db/gtdb-rs220/gtdb-reps-rs220-k31.zip", "https://farm.cse.ucdavis.edu/~ctbrown/sourmash-db/gtdb-rs220/gtdb-rs220.lineages.reps.csv" ]
            dbversion = "GTDB release 220 (https://doi.org/10.1093/nar/gkab776)"
	}
    }
    kraken_ref_db {
	'gtdb_220' {
            title = "GTDB release 220"
            url = [ "https://genome-idx.s3.amazonaws.com/kraken/k2_gtdb_genome_reps_20241109.tar.gz" ]
            dbversion = "GTDB release 220 (https://doi.org/10.1093/nar/gkab776)"
            fmtscript = "kraken_db_reformat.sh"
	}
        'standard-8' {
            title = "Standard Kraken2 DB capped at 8GB"
            url = [ "https://genome-idx.s3.amazonaws.com/kraken/k2_standard_08gb_20250402.tar.gz" ]
            dbversion = "Standard 8GB (https://benlangmead.github.io/aws-indexes/k2)"
            fmtscript = "kraken_db_reformat.sh"
        }
    }
    karga_ref_db {
        'megares' {
            title = "Megares v3.0"
            url = [ "https://www.meglab.org/downloads/megares_v3.00/megares_database_v3.00.fasta" ]
            dbversion = "Megares v3.0 (https://doi.org/10.1093/nar/gkac1047)"
        }
    }
    kargva_ref_db {
        'kargva' {
            title = "KARGVA database v5"
            url = [ "https://raw.githubusercontent.com/DataIntellSystLab/KARGVA/main/kargva_db_v5.fasta" ]
            dbversion = "KARGVA v5 (https://doi.org/10.3389/fmicb.2023.1060891)"
        }
    }
    blast_ref_db {
	'nt' {
            title = "Nucleotide NCBI Blast database"
            url = [ "https://ftp.ncbi.nlm.nih.gov/blast/db" ]
            dbversion = "NCBI nt, unversioned: latest state at download time (https://ftp.ncbi.nlm.nih.gov/blast/db)"
            fmtscript = "blast_nt_reformat.sh"
	}	
    }
    taxonomy_files {
	'ncbi' {
            title = "Taxonomy nodes and names from NCBI"
            url = [ "https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump.tar.gz" ]
            dbversion = "NCBI taxdump, unversioned: latest state at download time (https://ftp.ncbi.nlm.nih.gov/pub/taxonomy)"
            fmtscript = "tax_files_reformat.sh"
	}
    }
    checkm2_ref_db {
	'v3' {
            title = "Checkm2 database version 3"
            url = [ "https://zenodo.org/records/14897628/files/checkm2_database.tar.gz?download=1" ]
            dbversion = "Checkm2 database version 3 from (https://zenodo.org/records/14897628)"
            fmtscript = "checkm2_db_reformat.sh"
	}
    }
    // Not in this registry (audit #27) — their downloads are driven by their
    // own tools, not by a URL entry here:
    //  - DeepARG: DOWNLOAD_DEEPARG_DB runs `deeparg download_data`. The data
    //    is unversioned server-side; the tool version and download date are
    //    recorded in that task's versions.yml (aggregated into
    //    pipeline_info/software_versions.yml).
    //  - RGI CARD/WildCARD: RGI_LOAD downloads card.mcmaster.ca data per
    //    params.rgi_card_version (default 'latest' = unpinned; WildCARD is
    //    always latest). The actual CARD version is parsed from card.json
    //    into that task's versions.yml.
    gtdbtk_ref_db {
	'release_220' {
            title = "GTDB release 220 GTDB-TK version"
            url = [ "https://data.gtdb.ecogenomic.org/releases/release220/220.0/auxillary_files/gtdbtk_package/full_package/gtdbtk_r220_data.tar.gz" ]
            dbversion = "GTDB release 220 GTDB-TK version from (https://ecogenomics.github.io/GTDBTk/installing/index.html#sources)"
            fmtscript = "gtdb-tk_db_reformat.sh"
	}
    }
}
