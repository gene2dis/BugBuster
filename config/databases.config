params {
    bowtie_ref_host_index {
	'human' {
	    title = "T2T-CHM13v2.0"
	    url = [ "https://s3-us-west-2.amazonaws.com/human-pangenomics/T2T/CHM13/assemblies/analysis_set/chm13v2.0.fa.gz" ]
	    dbversion = "T2T-CHM13v2.0 analysis set (https://doi.org/10.1126/science.abj6987)"
	}
    }
    bowtie_ref_genomes_for_build {
	'phiX174' {
            title = "phiX genome"
            url = [ "https://ftp.ncbi.nlm.nih.gov/genomes/all/GCF/000/819/615/GCF_000819615.1_ViralProj14015/GCF_000819615.1_ViralProj14015_genomic.fna.gz" ]
            dbversion = "Escherichia phage phiX174, complete genome  (https://www.ncbi.nlm.nih.gov/nuccore/NC_001422.1?report=genbank)"
	}
    }
    sourmash_ref_db {
	'gtdb_220_k31' {
            title = "GTDB reps k31 release 220"
            url = [ "https://farm.cse.ucdavis.edu/~ctbrown/sourmash-db/gtdb-rs220/gtdb-reps-rs220-k31.zip", "https://farm.cse.ucdavis.edu/~ctbrown/sourmash-db/gtdb-rs220/gtdb-rs220.lineages.reps.csv" ]
            dbversion = "GTDB release 220 (https://doi.org/10.1093/nar/gkab776)"
	}
    }
    kraken_ref_db {
	'gtdb_220' {
            title = "GTDB release 220"
            url = [ "https://genome-idx.s3.amazonaws.com/kraken/k2_gtdb_genome_reps_20241109.tar.gz" ]
            dbversion = "GTDB release 220 (https://doi.org/10.1093/nar/gkab776)"
            fmtscript = "kraken_db_reformat.sh"
	}
        'standard-8' {
            title = "Standard Kraken2 DB capped at 8GB"
            url = [ "https://genome-idx.s3.amazonaws.com/kraken/k2_standard_08gb_20250402.tar.gz" ]
            dbversion = "Standard 8GB (https://benlangmead.github.io/aws-indexes/k2)"
            fmtscript = "kraken_db_reformat.sh"
        }
    }
    karga_ref_db {
        'megares' {
            title = "Megares v3.0"
            url = [ "https://www.meglab.org/downloads/megares_v3.00/megares_database_v3.00.fasta" ]
            dbversion = "Megares v3.0 (https://doi.org/10.1093/nar/gkac1047)"
        }
    }
    kargva_ref_db {
        'kargva' {
            title = "KARGVA database v5"
            url = [ "https://raw.githubusercontent.com/DataIntellSystLab/KARGVA/main/kargva_db_v5.fasta" ]
            dbversion = "KARGVA v5 (https://doi.org/10.3389/fmicb.2023.1060891)"
        }
    }
    blast_ref_db {
	'nt' {
            title = "Nucleotide NCBI Blast database"
            url = [ "https://ftp.ncbi.nlm.nih.gov/blast/db" ]
            dbversion = "NCBI nt, unversioned: latest state at download time (https://ftp.ncbi.nlm.nih.gov/blast/db)"
            fmtscript = "blast_nt_reformat.sh"
	}	
    }
    taxonomy_files {
	'ncbi' {
            title = "Taxonomy nodes and names from NCBI"
            url = [ "https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump.tar.gz" ]
            dbversion = "NCBI taxdump, unversioned: latest state at download time (https://ftp.ncbi.nlm.nih.gov/pub/taxonomy)"
            fmtscript = "tax_files_reformat.sh"
	}
    }
    checkm2_ref_db {
	'v3' {
            title = "Checkm2 database version 3"
            url = [ "https://zenodo.org/records/14897628/files/checkm2_database.tar.gz?download=1" ]
            dbversion = "Checkm2 database version 3 from (https://zenodo.org/records/14897628)"
            fmtscript = "checkm2_db_reformat.sh"
	}
    }
    // Not in this registry (audit #27) — their downloads are driven by their
    // own tools, not by a URL entry here:
    //  - DeepARG: DOWNLOAD_DEEPARG_DB runs `deeparg download_data`. The data
    //    is unversioned server-side; the tool version and download date are
    //    recorded in that task's versions.yml (aggregated into
    //    pipeline_info/software_versions.yml).
    //  - RGI CARD/WildCARD: RGI_LOAD downloads card.mcmaster.ca data per
    //    params.rgi_card_version (default 'latest' = unpinned; WildCARD is
    //    always latest). The actual CARD version is parsed from card.json
    //    into that task's versions.yml.
    gtdbtk_ref_db {
	'release_232' {
            title = "GTDB release 232 GTDB-TK version"
            // ~61 GB download. The pinned GTDB-Tk 2.7.x accepts ONLY R232
            // data (R220/R226 packages require GTDB-Tk <= 2.6.1), which is
            // why the former release_220 key was replaced, not kept.
            url = [ "https://data.gtdb.ecogenomic.org/releases/release232/232.0/auxillary_files/gtdbtk_package/full_package/gtdbtk_r232_data.tar.gz" ]
            dbversion = "GTDB release 232 GTDB-TK version, 2026-04-14 (https://ecogenomics.github.io/GTDBTk/installing/index.html#sources)"
            fmtscript = "gtdb-tk_db_reformat.sh"
	}
    }
    eggnog_ref_db {
	'emapper-3.0' {
            title = "eggNOG 7 orthology data for eggNOG-mapper v3 (emapper-3.0 layout)"
            // Base URL (blast-nt style): the fmtscript fetches the seven
            // uncompressed data files from it (~44 GB total). Per upstream's
            // MAJOR.MINOR data layout, the whole emapper 3.0.x series reuses
            // this same data directory.
            url = [ "https://data.cgmlab.org/eggnog-mapper/emapper-3.0/data" ]
            dbversion = "eggNOG 7.0.0 / emapper-3.0 data (https://data.cgmlab.org/eggnog-mapper/emapper-3.0/data)"
            fmtscript = "eggnog_db_reformat.sh"
	}
    }
    dbcan_ref_db {
	'db_v5-2-9_5-5-2026' {
            title = "dbCAN database release db_v5-2-9_5-5-2026 for run_dbcan v5 (CAZyme annotation set)"
            // Base URL: the pinned S3 release the run_dbcan 5.2.9 code itself
            // pins (upstream's pro.unl.edu HTTP mirror is a moving db_current
            // snapshot and must not be pinned). The fmtscript fetches the four
            // protein-mode CAZyme files (~7.4 GB total): CAZy.dmnd, dbCAN.hmm,
            // dbCAN_sub.hmm (saved as dbCAN-sub.hmm, the filename the tool
            // expects), fam-substrate-mapping.tsv.
            url = [ "https://dbcan.s3.us-west-2.amazonaws.com/db_v5-2-9_5-5-2026" ]
            dbversion = "dbCAN db_v5-2-9_5-5-2026 (https://dbcan.s3.us-west-2.amazonaws.com/db_v5-2-9_5-5-2026)"
            fmtscript = "dbcan_db_reformat.sh"
	}
    }
    bakta_ref_db {
	'v6.0-full' {
            title = "Bakta database v6.0, full (schema 6, for Bakta 1.12.x MAG annotation)"
            // Pinned per-version Zenodo tarball (bakta_db download floats to
            // the newest release and is not used). 31.9 GB download; the
            // fmtscript unpacks it, verifies the schema-6 layout including
            // the bundled AMRFinderPlus DB, then refreshes that AMR DB with
            // amrfinder_update (~300 MB; the bundled copy is too old for the
            // AMRFinderPlus in the pinned bakta container).
            url = [ "https://zenodo.org/record/14916843/files/db.tar.xz" ]
            dbversion = "Bakta DB v6.0 full, schema 6 (Zenodo record 14916843, 2025-02-24)"
            fmtscript = "bakta_db_reformat.sh"
	}
	'v6.0-light' {
            title = "Bakta database v6.0, light (schema 6, reduced annotation sources)"
            // The light DB changes annotation results. Selecting it is always
            // an explicit user choice (--bakta_db v6.0-light), recorded in
            // provenance via DB_VERSION -> versions.yml; the low_disk profile
            // never switches to it (design doc Q10). 1.3 GB download.
            url = [ "https://zenodo.org/record/14916843/files/db-light.tar.xz" ]
            dbversion = "Bakta DB v6.0 light, schema 6 (Zenodo record 14916843, 2025-02-24)"
            fmtscript = "bakta_db_reformat.sh"
	}
    }
    cog_ref_db {
	'cog-24' {
            title = "NCBI COG 2024 definitions table (COG id -> functional category letters)"
            // Maps the COG ortholog ids that eggNOG 7 writes into
            // COG_category (most genes) to COG functional-category letters
            // (design doc Q16, owner option b). Covers all 4,911 COG ids of
            // the eggNOG 7 database (verified 2026-10-07). ~410 KB; the
            // fmtscript verifies it against the release's checksums.md5.
            url = [ "https://ftp.ncbi.nlm.nih.gov/pub/COG/COG2024/data/cog-24.def.tab" ]
            dbversion = "NCBI COG 2024 (cog-24.def.tab)"
            fmtscript = "cog_db_reformat.sh"
	}
    }
    woltka_ref_db {
	'wolr2' {
            title = "Web of Life release 2 (WoLr2) for the Woltka read-level functional backend"
            // Base URL of the public WoLr2 release (README 2023-02-12; the
            // only populated WoL release - /pub/wol3/ is empty). The fmtscript
            // mirrors only the files the backend reads, keeping the FTP layout
            // verbatim (a hand-made mirror is a valid --custom_woltka_db):
            // the Bowtie2 index databases/bowtie2/WoLr2.*.bt2l (93.6 GB,
            // alignment needs >= 68 GB RAM), proteins/coords.txt.xz and
            // length.map.xz, and the KEGG / MetaCyc / Pfam function maps
            // (~0.6 GB). The pipeline bundles none of this data; KEGG- and
            // MetaCyc-derived maps are fetched from the official host on the
            // user's behalf (owner decision, design doc Q5).
            url = [ "https://ftp.microbio.me/pub/wol2" ]
            dbversion = "WoLr2 (https://ftp.microbio.me/pub/wol2, README 2023-02-12)"
            fmtscript = "woltka_db_reformat.sh"
	}
    }
}
