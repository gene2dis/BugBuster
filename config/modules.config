/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // nf-core module: FASTP (used via QC subworkflow)
    withName: '.*:FASTP' {
        ext.args = [
            "--qualified_quality_phred ${params.fastp_qualified_quality_phred}",
            "--unqualified_percent_limit ${params.fastp_unqualified_percent_limit}",
            "--cut_front",
            "--cut_front_window_size ${params.fastp_cut_front_window_size}",
            "--cut_front_mean_quality ${params.fastp_cut_front_mean_quality}",
            "--cut_right",
            "--cut_right_window_size ${params.fastp_cut_right_window_size}",
            "--cut_right_mean_quality ${params.fastp_cut_right_mean_quality}",
            "--detect_adapter_for_pe",
            "--n_base_limit ${params.fastp_n_base_limit}",
            "--trim_poly_g"
        ].join(' ').trim()
        publishDir = [
            [
                path: { "${params.output}/01_quality_control/fastp/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.{json,html,log}"
            ],
            [
                path: { "${params.output}/01_quality_control/fastp/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.fastp.fastq.gz",
                enabled: false  // Don't publish trimmed reads by default
            ]
        ]
    }

    // nf-core module: FASTP single-end invocation for singleton reads.
    // ext.prefix is required: without it the singleton run's outputs
    // (${meta.id}.fastp.json/.fastq.gz) would collide with the paired run's
    // when both are staged into QFILTER.
    withName: '.*:FASTP_SINGLETON' {
        ext.prefix = { "${meta.id}_Singleton" }
        ext.args = [
            "--qualified_quality_phred ${params.fastp_qualified_quality_phred}",
            "--unqualified_percent_limit ${params.fastp_unqualified_percent_limit}",
            "--cut_front",
            "--cut_front_window_size ${params.fastp_cut_front_window_size}",
            "--cut_front_mean_quality ${params.fastp_cut_front_mean_quality}",
            "--cut_right",
            "--cut_right_window_size ${params.fastp_cut_right_window_size}",
            "--cut_right_mean_quality ${params.fastp_cut_right_mean_quality}",
            "--n_base_limit ${params.fastp_n_base_limit}",
            "--trim_poly_g"
        ].join(' ').trim()
        publishDir = [
            [
                path: { "${params.output}/01_quality_control/fastp/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.{json,html,log}"
            ],
            [
                path: { "${params.output}/01_quality_control/fastp/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*.fastp.fastq.gz",
                enabled: false  // Don't publish trimmed reads by default
            ]
        ]
    }

    // nf-core module: KRAKEN2 (aliased from KRAKEN2_KRAKEN2)
    withName: '.*:KRAKEN2' {
        ext.args = [
            "--confidence ${params.kraken_confidence}"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.output}/02_taxonomy/kraken2" },
            mode: params.publish_dir_mode,
            pattern: "*report.txt",
            saveAs: { filename -> "${meta.id}_${filename}" }
        ]
    }

    // nf-core module: BRACKEN (aliased from BRACKEN_BRACKEN)
    withName: '.*:BRACKEN' {
        ext.args = [
            "-r ${params.bracken_read_len}",
            "-l ${params.bracken_tax_level}"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.output}/02_taxonomy/bracken" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : "${meta.id}_${filename}" }
        ]
    }

    // Taxonomy reporting module
    withName: '.*:TAXONOMY_REPORT' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
        time   = { 10.m * task.attempt }
    }

    // Phyloseq table generation module
    withName: '.*:TAXONOMY_PHYLOSEQ' {
        cpus   = 4
        memory = { 8.GB * task.attempt }
        time   = { 30.m * task.attempt }
        ext.format = 'both'  // Output format: 'tables', 'hdf5', or 'both'
    }

    // Optional R phyloseq converter module
    withName: '.*:PHYLOSEQ_CONVERTER' {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 20.m * task.attempt }  // Increased to allow phyloseq installation
        ext.validate = false  // Set to true to enable validation output
    }

    withName: 'BOWTIE2_DECONTAMINATE' {
        ext.args = [
            "--local",
            "--ma ${params.bowtie_ma}",
            "--mp ${params.bowtie_mp}",
            "--score-min ${params.bowtie_score_min}",
            "-k ${params.bowtie_k}",
            "-N ${params.bowtie_N}",
            "-L ${params.bowtie_L}",
            "-R ${params.bowtie_R}",
            "-i ${params.bowtie_i}"
        ].join(' ').trim()
        // Publishing is not caching: -resume is the cache. With store_clean_reads
        // the clean reads are copied to the output dir; the task still re-runs
        // whenever its inputs or params change (unlike the old storeDir misuse).
        publishDir = [
            path: { "${params.output}/clean_reads/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_clean.fastq.gz',
            enabled: params.store_clean_reads
        ]
    }

    withName: QFILTER {
        publishDir = [
            enabled: false  // Intermediate files - don't publish
        ]
    }

    withName: METACERBERUS_CONTIGS {
        ext.args = [
            "--hmm ${params.metacerberus_hmm}",
            "--minscore ${params.metacerberus_minscore}",
            "--evalue ${params.metacerberus_evalue}"
        ].join(' ').trim()
    }

    withName: DEEPARG_BINS {
        ext.args = [
            "--min-prob ${params.deeparg_min_prob}",
            "--arg-alignment-identity ${params.deeparg_arg_alignment_identity}",
            "--arg-alignment-evalue ${params.deeparg_arg_alignment_evalue}",
            "--arg-alignment-overlap ${params.deeparg_arg_alignment_overlap}",
            "--arg-num-alignments-per-entry ${params.deeparg_arg_num_alignments_per_entry}",
            "--model-version ${params.deeparg_model_version}"
        ].join(' ').trim()
    }

    withName: DEEPARG_CONTIGS {
        ext.args = [
            "--min-prob ${params.deeparg_min_prob}",
            "--arg-alignment-identity ${params.deeparg_arg_alignment_identity}",
            "--arg-alignment-evalue ${params.deeparg_arg_alignment_evalue}",
            "--arg-alignment-overlap ${params.deeparg_arg_alignment_overlap}",
            "--arg-num-alignments-per-entry ${params.deeparg_arg_num_alignments_per_entry}",
            "--model-version ${params.deeparg_model_version}"
        ].join(' ').trim()
        publishDir = [
            path: { "${params.output}/05_arg_prediction/contig_level/deeparg/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.ARG'
        ]
    }

    // nf-core module: PYRODIGAL — shared gene calling on contigs (design doc
    // Q9): one pass feeds DeepARG (contig_tax_and_arg) and functional
    // annotation (contig_level_functional). No container override needed: the
    // module ships a fully-qualified registry path (community.wave.seqera.io).
    withName: 'PYRODIGAL' {
        ext.args = '-p meta'
        publishDir = [
            path: { "${params.output}/07_functional_annotation/gene_calling/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // nf-core module: SAMTOOLS_INDEX
    withName: 'NFCORE_SAMTOOLS_INDEX' {
        // Same registry pinning as PRODIGAL_CONTIGS above
        container = 'quay.io/biocontainers/samtools:1.22.1--h96c455f_0'
        ext.args = ''
        publishDir = [
            enabled: false  // Intermediate file, keep in work directory
        ]
    }

    //
    // Local modules - QC
    //
    // COUNT_READS - Read counting for QC
    withName: 'COUNT_READS' {
        publishDir = [
            enabled: false  // Intermediate file - counts included in READS_REPORT
        ]
    }

    withName: 'READS_REPORT' {
        publishDir = [
            [
                path: { "${params.output}/01_quality_control/summary" },
                mode: params.publish_dir_mode,
                pattern: '*.csv'
            ],
            [
                path: { "${params.output}/01_quality_control/summary" },
                mode: params.publish_dir_mode,
                pattern: '*.png'
            ]
        ]
    }

    //
    // Local modules - Taxonomy
    //
    withName: 'SOURMASH' {
        publishDir = [
            path: { "${params.output}/02_taxonomy/sourmash" },
            mode: params.publish_dir_mode,
            pattern: '*.with-lineages.csv'
        ]
    }

    withName: 'TAXONOMY_REPORT' {
        publishDir = [
            [
                path: { "${params.output}/01_quality_control/summary" },
                mode: params.publish_dir_mode,
                pattern: 'Reads_report.csv'
            ],
            [
                path: { "${params.output}/02_taxonomy/figures" },
                mode: params.publish_dir_mode,
                pattern: '*.png'
            ]
        ]
    }

    withName: 'TAXONOMY_PHYLOSEQ' {
        publishDir = [
            [
                path: { "${params.output}/02_taxonomy/tables" },
                mode: params.publish_dir_mode,
                pattern: '*.tsv'
            ],
            [
                path: { "${params.output}/02_taxonomy/phyloseq" },
                mode: params.publish_dir_mode,
                pattern: '*.h5'
            ],
            [
                path: { "${params.output}/02_taxonomy/figures" },
                mode: params.publish_dir_mode,
                pattern: '*.png'
            ]
        ]
    }

    withName: 'PHYLOSEQ_CONVERTER' {
        publishDir = [
            path: { "${params.output}/02_taxonomy/phyloseq" },
            mode: params.publish_dir_mode,
            pattern: '*.RDS'
        ]
    }

    //
    // Local modules - Assembly
    //
    // BOWTIE2_SAMTOOLS - Alignment for binning/contig analysis
    withName: 'BOWTIE2_SAMTOOLS' {
        publishDir = [
            enabled: false  // Intermediate file - BAM used for depth calculation and indexing
        ]
    }

    // BOWTIE2_SAMTOOLS_PER_SAMPLE - aliased BOWTIE2_SAMTOOLS: per-sample
    // alignments against the co-assembly for gene quantification (design doc
    // Q1/T3; the pooled coassembly BAM has no read groups and cannot yield
    // per-sample counts). withName matches the alias, so the block above does
    // not cover it.
    withName: 'BOWTIE2_SAMTOOLS_PER_SAMPLE' {
        publishDir = [
            enabled: false  // Intermediate file - BAM used for featureCounts gene counting
        ]
    }

    // BOWTIE2_SAMTOOLS_DEPTH - Alignment for bin coverage (coassembly)
    withName: 'BOWTIE2_SAMTOOLS_DEPTH' {
        publishDir = [
            enabled: false  // Intermediate file - BAM used for bin coverage calculation
        ]
    }

    // CONTIG_FILTER_SUMMARY - Assembly filtering summary
    withName: 'CONTIG_FILTER_SUMMARY' {
        publishDir = [
            path: { "${params.output}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: 'contig_filtering_summary.txt'
        ]
    }

    // Unified MEGAHIT process handles both per-sample and co-assembly modes
    withName: 'MEGAHIT' {
        publishDir = [
            path: { meta.id == 'coassembly' ? "${params.output}/03_assembly/coassembly" : "${params.output}/03_assembly/per_sample/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_contigs.fa'
        ]
    }

    // Unified BBMAP process handles both per-sample and co-assembly modes
    withName: 'BBMAP' {
        publishDir = [
            [
                path: { meta.id == 'coassembly' ? "${params.output}/03_assembly/coassembly" : "${params.output}/03_assembly/per_sample/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '*_filtered_contigs.fa'
            ],
            [
                path: { meta.id == 'coassembly' ? "${params.output}/03_assembly/coassembly" : "${params.output}/03_assembly/per_sample/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '*_contig.stats'
            ]
        ]
    }

    //
    // Local modules - Binning
    //
    // CALCULATE_DEPTH - Depth calculation for MetaBAT2
    withName: 'CALCULATE_DEPTH' {
        publishDir = [
            enabled: false  // Intermediate file - depth consumed by MetaBAT2
        ]
    }

    // Unified binning modules - handle both per-sample and co-assembly modes
    //
    // Single METABAT2 selector: full arg set + mode-aware publishing.
    // (Audit #14: three overlapping selectors previously conflicted and the
    // winning one dropped --pTNF/--minCV/--minCVSum.)
    withName: 'METABAT2' {
        ext.args = [
            "--minContig ${params.metabat_minContig}",
            "--maxP ${params.metabat_maxP}",
            "--minS ${params.metabat_minS}",
            "--maxEdges ${params.metabat_maxEdges}",
            "--pTNF ${params.metabat_pTNF}",
            "--minCV ${params.metabat_minCV}",
            "--minCVSum ${params.metabat_minCVSum}",
            "--minClsSize ${params.metabat_minClsSize}",
            "--seed 3"
        ].join(' ').trim()
        publishDir = [
            path: { meta.id == 'coassembly' ?
                "${params.output}/04_binning/coassembly/raw_bins/metabat2" :
                "${params.output}/04_binning/per_sample/${meta.id}/raw_bins/metabat2" },
            mode: params.publish_dir_mode,
            pattern: '*metabat_bins'
        ]
    }

    withName: 'SEMIBIN' {
        publishDir = [
            path: { meta.id == 'coassembly' ? 
                "${params.output}/04_binning/coassembly/raw_bins/semibin" : 
                "${params.output}/04_binning/per_sample/${meta.id}/raw_bins/semibin" },
            mode: params.publish_dir_mode,
            pattern: '*semibin_output_bins'
        ]
    }

    withName: 'COMEBIN' {
        publishDir = [
            path: { meta.id == 'coassembly' ? 
                "${params.output}/04_binning/coassembly/raw_bins/comebin" : 
                "${params.output}/04_binning/per_sample/${meta.id}/raw_bins/comebin" },
            mode: params.publish_dir_mode,
            pattern: '*_comebin_bins/comebin_res/comebin_res_bins'
        ]
    }

    withName: 'METAWRAP' {
        publishDir = [
            path: { meta.id == 'coassembly' ? 
                "${params.output}/04_binning/coassembly/refined_bins" : 
                "${params.output}/04_binning/per_sample/${meta.id}/refined_bins" },
            mode: params.publish_dir_mode,
            pattern: '*metawrap*bins'
        ]
    }

    withName: 'CHECKM2_BATCH' {
        // MetaWRAP names its output dir from these params; the batch step needs the
        // same suffix to recognize refined-bin directories (audit #6)
        ext.metawrap_dir_suffix = { "metawrap_${params.metawrap_completeness}_${params.metawrap_contamination}_bins" }
        publishDir = [
            path: { "${params.output}/04_binning/per_sample" },
            mode: params.publish_dir_mode,
            pattern: '*_*_quality_report.tsv',
            saveAs: { filename ->
                // Extract sample_id from filename: S10_Ago2021_metabat_quality_report.tsv
                def parts = filename.tokenize('_')
                def binnerIdx = parts.findLastIndexOf { part -> part in ['metabat', 'semibin', 'comebin', 'metawrap'] }
                if (binnerIdx > 0) {
                    def sample_id = parts[0..<binnerIdx].join('_')
                    return "${sample_id}/quality/checkm2/${filename}"
                }
                return null
            }
        ]
    }

    withName: 'GTDB_TK_BATCH' {
        // MetaWRAP names its output dir from these params; the batch step needs the
        // same suffix to recognize refined-bin directories (audit #6)
        ext.metawrap_dir_suffix = { "metawrap_${params.metawrap_completeness}_${params.metawrap_contamination}_bins" }
        publishDir = [
            path: { "${params.output}/04_binning/per_sample" },
            mode: params.publish_dir_mode,
            pattern: '*_gtdbtk_*.tsv',
            saveAs: { filename ->
                // Extract sample_id from filename: S10_Ago2021_gtdbtk_bac120.tsv
                def parts = filename.tokenize('_')
                def gtdbIdx = parts.findLastIndexOf { part -> part == 'gtdbtk' }
                if (gtdbIdx > 0) {
                    def sample_id = parts[0..<gtdbIdx].join('_')
                    return "${sample_id}/taxonomy/gtdbtk/${filename}"
                }
                return null
            }
        ]
    }

    withName: 'BIN_QUALITY_REPORT' {
        publishDir = [
            [
                path: { "${params.output}/04_binning/quality/summary" },
                mode: params.publish_dir_mode,
                pattern: '*.png'
            ],
            [
                path: { "${params.output}/04_binning/quality/summary" },
                mode: params.publish_dir_mode,
                pattern: '*.csv'
            ]
        ]
    }

    withName: 'BIN_TAX_REPORT' {
        publishDir = [
            [
                path: { "${params.output}/04_binning/taxonomy/summary" },
                mode: params.publish_dir_mode,
                pattern: '*.png'
            ],
            [
                path: { "${params.output}/04_binning/taxonomy/summary" },
                mode: params.publish_dir_mode,
                pattern: '*.csv'
            ]
        ]
    }

    withName: 'BIN_SUMMARY' {
        publishDir = [
            path: { "${params.output}/04_binning/coassembly/summary" },
            mode: params.publish_dir_mode,
            pattern: 'Bin_summary.csv'
        ]
    }

    withName: 'BEDTOOLS' {
        publishDir = [
            path: { "${params.output}/04_binning/coassembly/coverage" },
            mode: params.publish_dir_mode,
            pattern: '*_bin_depth.tsv'
        ]
    }

    //
    // Local modules - ARG Prediction
    //
    withName: 'KARGA' {
        publishDir = [
            path: { "${params.output}/05_arg_prediction/read_level/karga" },
            mode: params.publish_dir_mode,
            pattern: '*_KARGA_mappedGenes.csv'
        ]
    }

    withName: 'KARGVA' {
        publishDir = [
            path: { "${params.output}/05_arg_prediction/read_level/kargva" },
            mode: params.publish_dir_mode,
            pattern: '*_KARGVA_mappedGenes.csv'
        ]
    }

    withName: 'ARGS_OAP' {
        publishDir = [
            path: { "${params.output}/05_arg_prediction/read_level/args_oap" },
            mode: params.publish_dir_mode,
            pattern: '*args_oap_s1_out'
        ]
    }

    withName: 'ARG_NORM_REPORT' {
        publishDir = [
            path: { "${params.output}/05_arg_prediction/read_level/summary" },
            mode: params.publish_dir_mode,
            pattern: '*.csv'
        ]
    }

    withName: 'DEEPARG_BINS' {
        publishDir = [
            path: { "${params.output}/05_arg_prediction/bin_level/deeparg/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_deeparg_results'
        ]
    }

    withName: 'ARG_CONTIG_LEVEL_REPORT' {
        publishDir = [
            path: { "${params.output}/05_arg_prediction/contig_level/summary" },
            mode: params.publish_dir_mode,
            pattern: 'Contig_tax_and_arg_prediction.tsv'
        ]
    }

    withName: 'ARG_BLOBPLOT' {
        publishDir = [
            path: { "${params.output}/05_arg_prediction/contig_level/figures" },
            mode: params.publish_dir_mode,
            pattern: '*.png'
        ]
    }

    withName: 'CLUSTERING' {
        publishDir = [
            path: { "${params.output}/05_arg_prediction/bin_level/clustering" },
            mode: params.publish_dir_mode,
            pattern: '*_cluster.tsv'
        ]
    }

    withName: 'PRODIGAL_BINS' {
        publishDir = [
            path: { "${params.output}/05_arg_prediction/bin_level/proteins/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_bins_proteins'
        ]
    }

    //
    // Local modules - Contig Taxonomy
    //
    // NT_BLASTN - BLAST against nt database for taxonomy
    withName: 'NT_BLASTN' {
        ext.args = '-max_target_seqs 1 -max_hsps 1 -evalue 1e-25'
        publishDir = [
            enabled: false  // Intermediate file - BLAST results consumed by BLOBTOOLS
        ]
    }

    // BLOBTOOLS - Generate blob tables for taxonomy visualization
    withName: 'BLOBTOOLS' {
        publishDir = [
            enabled: false  // Intermediate file - blob tables consumed by BLOBPLOT
        ]
    }

    withName: 'BLOBPLOT' {
        publishDir = [
            path: { "${params.output}/06_contig_taxonomy/figures" },
            mode: params.publish_dir_mode,
            pattern: '*.png'
        ]
    }

    //
    // Local modules - Functional Annotation
    //
    withName: 'METACERBERUS_CONTIGS' {
        publishDir = [
            path: { "${params.output}/07_functional_annotation/contigs/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*_annotation_results'
        ]
    }

    // eggNOG-mapper v3 two-stage run (design doc Section 4.2): structural
    // flags (-m diamond/--no_annot, -m no_search/--annotate_hits_table,
    // --itype, --cpu, --data_dir) are hardcoded in the modules; ext.args
    // carries only optional thresholds (v3 names: --annot_evalue,
    // --annot_score, sensitivity flags)
    withName: 'EGGNOG_MAPPER_SEARCH' {
        ext.args = ''
        publishDir = [
            path: { "${params.output}/07_functional_annotation/eggnog/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.emapper.seed_orthologs'
        ]
    }

    withName: 'EGGNOG_MAPPER_ANNOTATE' {
        ext.args = ''
        publishDir = [
            path: { "${params.output}/07_functional_annotation/eggnog/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.emapper.annotations'
        ]
    }

    // RUN_DBCAN - CAZy annotation of the predicted proteins (design doc
    // Section 4.3, T6): structural flags (CAZyme_annotation subcommand,
    // --mode protein, --input_raw_data, --db_dir, --output_dir, --threads)
    // are hardcoded in the module; ext.args carries only optional thresholds
    // (--e_value_threshold, --e_value_threshold_dbcan/--coverage_threshold_dbcan,
    // --e_value_threshold_dbsub/--coverage_threshold_dbsub)
    withName: 'RUN_DBCAN' {
        ext.args = ''
        publishDir = [
            path: { "${params.output}/07_functional_annotation/dbcan/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{overview.tsv,dbCANsub_hmm_results.tsv,dbCAN_hmm_results.tsv,diamond.out}'
        ]
    }

    // FEATURECOUNTS_GENES - per-gene read counts (design doc Section 4.4, T3):
    // structural flags (-F SAF, -T, -p with single-end fallback) and the
    // multi-mapping policy (params.featurecounts_multimap) are resolved in the
    // module; ext.args carries only optional extras
    withName: 'FEATURECOUNTS_GENES' {
        ext.args = ''
        publishDir = [
            path: { "${params.output}/07_functional_annotation/gene_abundance/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.featureCounts.txt*'
        ]
    }

    // MICROBECENSUS - average genome size / genome equivalents (design doc
    // Section 4.7, T5). Failure must be non-fatal to the run: OOM-class exits
    // retry per the pipeline default, everything else is ignored, and the
    // sample gets no CPGE: TPM-only in AGGREGATE_FUNCTIONS ('unavailable' row
    // in ags_and_ge.tsv) and native read counts only in
    // AGGREGATE_READ_FUNCTIONS (cpge_status 'unavailable' in
    // read_sample_summary.tsv)
    withName: 'MICROBECENSUS' {
        ext.args = ''
        errorStrategy = { task.exitStatus in ((130..145) + 104) && task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries = 2
        publishDir = [
            path: { "${params.output}/07_functional_annotation/microbecensus/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{ags.tsv,microbecensus.txt}'
        ]
    }

    // AGGREGATE_FUNCTIONS - study-level tables (design doc Sections 4.8, 9.1):
    // gene/function abundance with TPM and CPGE, wide matrices, annotated
    // fraction, AGS summary
    withName: 'AGGREGATE_FUNCTIONS' {
        ext.args = ''
        publishDir = [
            path: { "${params.output}/07_functional_annotation/summary" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    // WOLTKA_ALIGN - Bowtie2 vs WoLr2 for the Woltka read-level functional
    // backend (design doc Section 4.6.2, T8a). ext.args = the SHOGUN multi-hit
    // set from the WoLr2 Bowtie2 README (owner decision 2026-10-07; Woltka
    // divides multi-hit reads 1/k unless --woltka_uniq). -x/-1/-2/-U,
    // --no-head and --no-unal are fixed in the module. Only the log is
    // published: the trimmed SAM is a large intermediate
    withName: 'WOLTKA_ALIGN' {
        ext.args = '--very-sensitive -k 16 --np 1 --mp "1,1" --rdg "0,1" --rfg "0,1" --score-min "L,0,-0.05" --seed 42'
        publishDir = [
            path: { "${params.output}/07_functional_annotation/reads/woltka/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.bowtie2.log'
        ]
    }

    // WOLTKA_CLASSIFY - ORF classification + per-function composition
    // (design doc Section 4.6.2, T8a). --woltka_uniq maps to woltka --uniq
    // (normalized: an explicit CLI `--woltka_uniq false` arrives as the
    // String "false", Q13)
    withName: 'WOLTKA_CLASSIFY' {
        ext.args = { params.woltka_uniq.toString().toBoolean() ? '--uniq' : '' }
        publishDir = [
            path: { "${params.output}/07_functional_annotation/reads/woltka/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.woltka_*.tsv'
        ]
    }

    // SUPERFOCUS - SUPER-FOCUS read-level SEED profiling (design doc Section
    // 4.6.3, T8b, Q17). ext.args = SUPER-FOCUS 1.8's own defaults, spelled
    // out: >= 60 % identity, >= 15 aa alignment, e-value 1e-5, fast aligner
    // mode. -q/-dir/-a/-db DB_90/-b/-t/-tmp/-d/-l and -n 1 (the 1/k
    // division the per-level composition relies on) are fixed in the module;
    // the aligner comes from --superfocus_aligner. Published: the per-sample
    // composed tables, SUPER-FOCUS's raw tables and its log (never the
    // per-read binning table or the alignments)
    withName: 'SUPERFOCUS' {
        ext.args = '-mi 60 -ml 15 -e 0.00001 -f 1'
        publishDir = [
            path: { "${params.output}/07_functional_annotation/reads/superfocus/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.superfocus{_*.tsv,_*.xls,.log}'
        ]
    }

    // AGGREGATE_READ_FUNCTIONS - study-level read-branch tables (design doc
    // Sections 4.6, 5.3, 9.1): read_*-prefixed, reported separately from the
    // contig branch's AGGREGATE_FUNCTIONS tables in the same summary/ dir
    withName: 'AGGREGATE_READ_FUNCTIONS' {
        ext.args = ''
        publishDir = [
            path: { "${params.output}/07_functional_annotation/summary" },
            mode: params.publish_dir_mode,
            pattern: 'read_*.tsv'
        ]
    }

    // nf-core module: BAKTA_BAKTA - per-bin MAG annotation (design doc
    // Section 4.5, T7). Container pinned here to Bakta 1.12.1 (Section 4.0
    // registry-pinning convention, NFCORE_SAMTOOLS_INDEX precedent): the
    // module ships a wave image with 1.12.0. Structural flags (--db,
    // --prefix, --threads) live in the module; ext.args carries optional
    // flags only: --skip-plot (plots are slow, unpublished, and not in the
    // module's emits) and --keep-contig-headers (bin contig IDs stay
    // traceable to the assembly contigs). meta.id is the source sample
    // (Section 9.1 keying); meta.bin (from the fan-out in
    // functional_annotation.nf) disambiguates files within the sample dir.
    withName: 'BAKTA_BAKTA' {
        container  = 'quay.io/biocontainers/bakta:1.12.1--pyhdfd78af_0'
        ext.args   = '--skip-plot --keep-contig-headers'
        ext.prefix = { "${meta.id}_${meta.bin}" }
        publishDir = [
            path: { "${params.output}/07_functional_annotation/mags/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{gff3,gbff,faa,fna,tsv,txt}'
        ]
    }

    //
    // Database modules
    //
    withName: 'FORMAT_KRAKEN_DB' {
        publishDir = [
            path: { "${params.databases_dir}/kraken" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: '*'
        ]
    }

    withName: 'FORMAT_NT_BLAST_DB' {
        publishDir = [
            path: { "${params.databases_dir}/blast" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: '*'
        ]
    }

    withName: 'FORMAT_TAXDUMP_FILES' {
        publishDir = [
            path: { "${params.databases_dir}/taxdump" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: '*'
        ]
    }

    withName: 'DOWNLOAD_DEEPARG_DB' {
        publishDir = [
            path: { "${params.databases_dir}" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: 'deeparg_db'
        ]
    }

    withName: 'FORMAT_CHECKM2_DB' {
        publishDir = [
            path: { "${params.databases_dir}/checkm2" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: '*.dmnd'
        ]
    }

    withName: 'BOWTIE2_BUILD_COMBINED' {
        publishDir = [
            path: { "${params.databases_dir}/bowtie_index" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: 'contaminants_index'
        ]
    }

    withName: 'DOWNLOAD_GTDBTK_DB' {
        publishDir = [
            path: { "${params.databases_dir}/gtdbtk" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: '*'
        ]
    }

    withName: 'FORMAT_EGGNOG_DB' {
        publishDir = [
            path: { "${params.databases_dir}/eggnog" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: 'eggnog_db'
        ]
    }

    withName: 'FORMAT_DBCAN_DB' {
        publishDir = [
            path: { "${params.databases_dir}/dbcan" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: 'dbcan_db'
        ]
    }

    withName: 'FORMAT_BAKTA_DB' {
        publishDir = [
            path: { "${params.databases_dir}/bakta" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: 'bakta_db'
        ]
    }

    withName: 'FORMAT_COG_DB' {
        publishDir = [
            path: { "${params.databases_dir}/cog" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: '*.def.tab'
        ]
    }

    withName: 'FORMAT_WOLTKA_DB' {
        publishDir = [
            path: { "${params.databases_dir}/woltka" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: 'woltka_db'
        ]
    }

    withName: 'FORMAT_SUPERFOCUS_DB' {
        publishDir = [
            path: { "${params.databases_dir}/superfocus" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: 'superfocus_db'
        ]
    }

    withName: 'SOURMASH_TAX_PREPARE' {
        publishDir = [
            path: { "${params.databases_dir}/sourmash" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: '*.sqldb'
        ]
    }

    //
    // RGI modules
    //
    withName: 'RGI_LOAD' {
        label = 'process_download'
        publishDir = [
            path: { "${params.databases_dir}/rgi" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: 'card_db'
        ]
    }

    withName: 'RGI_LOAD_WILDCARD' {
        label = 'process_medium'
        publishDir = [
            path: { "${params.databases_dir}/rgi" },
            // No database storage location configured (e.g. module-level nf-tests
            // run without --output, leaving databases_dir null): publish nothing
            // instead of writing to a literal ./null/... path
            enabled: params.databases_dir != null,
            mode: params.publish_dir_mode,
            pattern: 'card_db_with_wildcard'
        ]
    }

    withName: 'RGI_BWT' {
        ext.args = ''
        time   = { 72.h * task.attempt }
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
        maxRetries = 2
        publishDir = [
            [
                path: { "${params.output}/05_arg_prediction/read_level/rgi/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: '*.{txt,bam}'
            ]
        ]
    }

    withName: 'RGI_KMER' {
        ext.args = ''
        publishDir = [
            path: { "${params.output}/05_arg_prediction/read_level/rgi_kmer/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,txt}'
        ]
    }

    withName: 'RGI_REPORT' {
        publishDir = [
            [
                path: { "${params.output}/05_arg_prediction/read_level/rgi_summary" },
                mode: params.publish_dir_mode,
                pattern: '*.csv'
            ],
            [
                path: { "${params.output}/05_arg_prediction/read_level/rgi_summary" },
                mode: params.publish_dir_mode,
                pattern: '*.png'
            ]
        ]
    }
}
