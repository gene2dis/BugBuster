/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BugBuster Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Parameter validation plugin (nextflow_schema.json is enforced at startup
// by validateParameters() in main.nf). nf-schema >= 2.7.2 is required for the
// strict syntax parser (default since Nextflow 26.04): older versions do not
// cast CLI-provided params to their schema types under that parser. It itself
// requires Nextflow >= 25.10; bump plugin + nextflowVersion together.
plugins {
    id 'nf-schema@2.7.3'
}

// Pipeline manifest
manifest {
    name            = 'gene2dis/BugBuster'
    author          = """Francisco A. Fuentes, Juan A. Ugalde, Carolina Curiqueo"""
    homePage        = 'https://github.com/gene2dis/BugBuster'
    description     = """Bacterial Unraveling and metaGenomic Binning with Up-Scale Throughput, Efficient and Reproducible"""
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    version         = '1.1.0dev'
    doi             = ''
}

// Pipeline execution parameters
params {
    // Input/Output options
    input                      = null
    output                     = null

    // Pipeline execution options
    quality_control            = true
    assembly_mode              = "assembly"    // Options: "coassembly", "assembly", "none"
    taxonomic_profiler         = "sourmash"    // Options: "kraken2", "sourmash", "none"
    
    // Feature toggles
    help                       = false
    read_arg_prediction        = false
    rgi_prediction             = false
    contig_level_metacerberus  = false
    contig_level_functional    = false
    mag_level_functional       = false  // Bakta on refined bins; requires include_binning and >= 2 binners
    read_level_functional      = "none"  // Read-level functional profiling backend. Options: "woltka", "superfocus", "humann", "none"
    contig_tax_and_arg         = false
    include_binning            = false
    binners                    = "semibin"  // Comma-separated list of binners: comebin, semibin, metabat2
    arg_bin_clustering         = false

    // Quality filtering
    min_read_sample            = 0

    // Database selection (automatic download)
    phiX_index                 = 'phiX174'
    host_db                    = 'human'
    kraken2_db                 = 'standard-8'
    karga_db                   = 'megares'
    kargva_db                  = 'kargva'
    sourmash_db                = 'gtdb_220_k31'
    blast_db                   = 'nt'
    taxdump_files              = 'ncbi'
    checkm2_db                 = 'v3'
    gtdbtk_db                  = 'release_232'
    eggnog_db                  = 'emapper-3.0'
    dbcan_db                   = 'db_v5-2-9_5-5-2026'
    bakta_db                   = 'v6.0-full'  // 'v6.0-light' is an explicit choice, recorded in provenance
    woltka_db                  = 'wolr2'
    superfocus_db              = 'db90'
    humann_db                  = 'v4_alpha-full'  // 'v4_alpha-ec_filtered' (6.9 GB ChocoPhlAn instead of 44.8 GB) is an explicit choice, recorded in provenance
    cog_db                     = 'cog-24'

    // Custom database paths (overrides automatic download)
    custom_decontamination_index = null  // Combined phiX + host Bowtie2 index (recommended)
    custom_phiX_fasta          = null    // Custom phiX FASTA for building combined index
    custom_host_fasta          = null    // Custom host FASTA for building combined index
    custom_kraken_db           = null
    custom_karga_db            = null
    custom_kargva_db           = null
    custom_sourmash_db         = null  // Needs to be a list: ["kmer_file","lineages_file"]
    custom_blast_db            = null
    custom_taxdump_files       = null
    custom_deeparg_db          = null
    custom_checkm2_db          = null
    custom_gtdbtk_db           = null
    custom_rgi_card_db         = null
    custom_rgi_wildcard        = null
    custom_eggnog_db           = null  // eggNOG 7 / emapper-3.0 data dir: eggnog.db (+ .fieldpresence.bin/.taxids.bin), eggnog.taxa.db (+ .traverse.pkl), eggnog_proteins.dmnd, go-basic.obo
    custom_dbcan_db            = null  // dbCAN db dir: CAZy.dmnd, dbCAN.hmm, dbCAN-sub.hmm, fam-substrate-mapping.tsv (run_dbcan v5 layout)
    custom_bakta_db            = null  // Bakta db dir (schema 6 layout: version.json, amrfinderplus-db/, ...)
    custom_cog_db              = null  // NCBI COG definitions table file (cog-24.def.tab layout: COG id <TAB> category letters <TAB> ...)
    custom_woltka_db           = null  // WoLr2 mirror dir (FTP layout: databases/bowtie2/WoLr2.*.bt2l, proteins/, function/{kegg,metacyc,pfam}/)
    custom_superfocus_db       = null  // SUPER-FOCUS database ROOT (db/database_PKs.txt + db/static/{diamond/90_clusters.db.dmnd | mmseqs2/90_clusters.db*})
    custom_humann_db           = null  // HUMAnN database ROOT: chocophlan/, uniref/, utility_mapping/, metaphlan/ (mpa_vOct22_CHOCOPhlAnSGB_202403.pkl + .bt2l index)

    // Tool-specific parameters
    // FASTP
    fastp_n_base_limit               = 5
    fastp_unqualified_percent_limit  = 10
    fastp_qualified_quality_phred    = 20
    fastp_cut_front_window_size      = 4
    fastp_cut_front_mean_quality     = 20
    fastp_cut_right_window_size      = 4
    fastp_cut_right_mean_quality     = 20

    // KRAKEN2
    kraken_confidence          = 0.1

    // BRACKEN
    bracken_read_len           = 150
    bracken_tax_level          = "S"

    // SOURMASH (tax_rank options: "genus", "species", "strain")
    sourmash_tax_rank          = "species"

    // TAXONOMY OUTPUT OPTIONS
    taxonomy_plot_levels       = "Phylum,Family,Genus,Species"  // Taxonomic levels to plot
    taxonomy_top_n_taxa        = 10                              // Number of top taxa in plots
    create_phyloseq_rds        = false                           // Generate R phyloseq RDS files

    // BOWTIE2
    bowtie_ma                  = 2
    bowtie_mp                  = '6,2'
    bowtie_score_min           = 'G,15,6'
    bowtie_k                   = 1
    bowtie_N                   = 1
    bowtie_L                   = 20
    bowtie_R                   = 2
    bowtie_i                   = 'S,1,0.75'

    // BBMAP
    bbmap_length               = 1000

    // METABAT2
    metabat_minContig          = 2500
    metabat_maxP               = 95
    metabat_minS               = 60
    metabat_maxEdges           = 200
    metabat_pTNF               = 0
    metabat_minCV              = 1
    metabat_minCVSum           = 1
    metabat_minClsSize         = 200000

    // METAWRAP
    metawrap_completeness      = 50
    metawrap_contamination     = 10

    // DEEPARG
    deeparg_min_prob                     = 0.8
    deeparg_arg_alignment_identity       = 50
    deeparg_arg_alignment_evalue         = "1e-10"
    deeparg_arg_alignment_overlap        = 0.8
    deeparg_arg_num_alignments_per_entry = 1000
    deeparg_model_version                = 'v2'

    // METACERBERUS (HMM options: KOFam_all, KOFam_eukaryote, KOFam_prokaryote, COG, VOG, PHROG, CAZy)
    metacerberus_hmm           = '"KOFam_all, COG, VOG, PHROG, CAZy"'
    metacerberus_minscore      = 25
    metacerberus_evalue        = 1e-09

    // RGI (CARD AMR prediction)
    rgi_card_version           = 'latest'          // CARD version: 'latest' or specific version
    rgi_include_wildcard       = true              // Include WildCARD variants
    rgi_aligner                = 'kma'             // Aligner: kma, bowtie2, bwa
    rgi_kmer_size              = 61                // K-mer size for pathogen prediction
    rgi_min_kmer_coverage      = 10                // Minimum k-mer coverage

    // SEMIBIN (models: human_gut, dog_gut, ocean, soil, cat_gut, human_oral, mouse_gut, pig_gut, built_environment, wastewater, chicken_caecum, global)
    semibin_env_model          = "human_gut"

    // FEATURECOUNTS (gene quantification, functional annotation branch)
    // Multi-mapping policy: primary (count primary alignments only), all (-M,
    // count every reported alignment), none (exclude multi-mapping reads)
    featurecounts_multimap     = 'primary'

    // MICROBECENSUS (average genome size, contig and read functional branches).
    // Enables copies-per-genome-equivalent normalization; failure is
    // non-fatal (the sample falls back to TPM-only)
    microbecensus              = true

    // RUN_DBCAN (CAZy annotation, functional annotation branch).
    // functional_cazy toggles the dbCAN CAZy branch when the contig
    // functional branch is enabled. dbcan_consensus picks which dbCAN calls
    // feed aggregation: 'recommended' (calls supported by >= 2 tools, the
    // tool's Recommend Results column) or 'any' (union of the per-tool calls)
    functional_cazy            = true
    dbcan_consensus            = 'recommended'

    // WOLTKA (read-level functional branch, --read_level_functional woltka).
    // Reads are aligned to WoLr2 with the SHOGUN multi-hit Bowtie2 settings
    // and Woltka divides a read whose (up to 16) reported alignments hit k ORFs 1/k to each.
    // woltka_uniq instead leaves such ambiguous reads unassigned (counted in
    // read_sample_summary.tsv)
    woltka_uniq                = false

    // SUPER-FOCUS (read-level functional branch, --read_level_functional superfocus).
    // Translated search of the reads against the DB_90 SEED cluster database;
    // the cluster level is fixed (design doc Q17). Identity / alignment-length /
    // e-value thresholds: SUPERFOCUS ext.args in config/modules.config
    superfocus_aligner         = 'diamond'  // Options: 'diamond', 'mmseqs2'

    // Output options
    publish_dir_mode           = 'copy'

    // Database storage (separate from results output).
    // Guarded: with --output unset (e.g. --help) an eager "${params.output}"
    // interpolation would bake a literal "null/../databases" path.
    databases_dir              = params.output ? "${params.output}/../databases" : null

    // Cleanup and storage options
    store_clean_reads          = false  // Publish clean reads to <output>/clean_reads (publishing, not caching: -resume is the cache)
    
    // Max resource options (defaults - can be overridden)
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    // Cloud/HPC profile options (consumed by conf/{aws,gcp,azure,slurm}.config
    // and conf/institutional.config; audit #24). The *_workdir params are
    // required when their profile is active - validated in main.nf.
    // AWS Batch (-profile aws)
    aws_workdir                = null              // S3 work directory, e.g. s3://my-bucket/work (required with -profile aws)
    aws_queue                  = 'default'         // AWS Batch job queue
    aws_region                 = 'us-east-1'       // AWS region
    aws_cli_path               = '/home/ec2-user/miniconda/bin/aws'  // Path to the aws CLI on the Batch AMI
    aws_job_role               = null              // IAM job role ARN (optional)
    aws_execution_role         = null              // IAM execution role ARN (optional)
    aws_volumes                = null              // Container volumes for scratch space (optional)
    // Google Cloud Batch (-profile gcp)
    gcp_workdir                = null              // GCS work directory, e.g. gs://my-bucket/work (required with -profile gcp)
    gcp_project                = null              // GCP project id
    gcp_region                 = 'us-central1'     // GCP location
    gcp_spot                   = false             // Use spot/preemptible instances
    gcp_boot_disk_size         = '50.GB'           // Boot disk size per VM
    gcp_service_account        = null              // Service account email (optional)
    gcp_network                = null              // VPC network (optional)
    gcp_subnetwork             = null              // VPC subnetwork (optional)
    gcp_private_address        = false             // Use private IP addresses only
    // Azure Batch (-profile azure)
    azure_workdir              = null              // Blob work directory, e.g. az://container/work (required with -profile azure)
    azure_pool                 = 'auto'            // Batch pool name
    azure_region               = 'eastus'          // Azure location
    azure_batch_account        = null              // Batch account name
    azure_batch_key            = null              // Batch account key
    azure_storage_account      = null              // Storage account name
    azure_storage_key          = null              // Storage account key
    azure_delete_pools         = true              // Delete auto pools on completion
    azure_vm_type              = 'Standard_D4_v3'  // VM type for auto pools
    azure_vm_count             = 1                 // Initial VM count
    azure_max_vms              = 10                // Maximum VM count
    azure_spot                 = false             // Use low-priority (spot) VMs
    // SLURM (-profile slurm)
    slurm_queue                = 'normal'          // Default partition
    slurm_queue_short          = null              // Partition for short jobs (optional)
    slurm_queue_long           = null              // Partition for long jobs (optional)
    slurm_account              = null              // Account for job submission (optional)
    slurm_queue_size           = 100               // Executor queue size
    // Shared profile helpers
    singularity_cache          = null              // Singularity image cache dir (optional)
    singularity_run_options    = null              // Extra singularity run options (optional)
    config_profile_name        = null              // Set by profile configs, informational
    config_profile_description = null              // Set by profile configs, informational
    config_profile_contact     = null              // Set by profile configs, informational
    config_profile_url         = null              // Set by profile configs, informational
    // Timestamp suffix for the execution timeline/report/trace/dag files
    // (evaluated once so all four share it)
    trace_report_suffix        = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
}

// nf-schema parameter validation (https://nextflow-io.github.io/nf-schema/)
validation {
    // All live params (incl. the cloud/HPC profile params, audit #24) are in
    // nextflow_schema.json, so a param the schema does not know is a typo:
    // fail hard instead of warning. (nf-schema >= 2.5 name for the former
    // failUnrecognisedParams = true)
    logging {
        unrecognisedParams = 'error'
    }
    // The *_ref_db / *_files maps are the internal database registry from
    // config/databases.config (config data, not user-facing knobs)
    defaultIgnoreParams    = [
        'help', 'version',
        'bowtie_ref_host_index', 'bowtie_ref_genomes_for_build',
        'sourmash_ref_db', 'kraken_ref_db', 'karga_ref_db', 'kargva_ref_db',
        'blast_ref_db', 'taxonomy_files', 'checkm2_ref_db', 'gtdbtk_ref_db',
        'eggnog_ref_db', 'dbcan_ref_db', 'bakta_ref_db', 'woltka_ref_db', 'superfocus_ref_db', 'humann_ref_db', 'cog_ref_db'
    ]
}

// Profiles for different execution environments
profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    // Legacy profiles for backward compatibility
    local_docker {
        docker.enabled          = true
        singularity.enabled     = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    slurm_singularity {
        process.executor        = 'slurm'
        singularity.enabled     = true
        singularity.autoMounts  = true
        docker.enabled          = false
    }
    // Test profile with minimal test data
    test {
        includeConfig 'conf/test.config'
    }

    //
    // Cloud execution profiles
    //
    aws {
        includeConfig 'conf/aws.config'
    }
    gcp {
        includeConfig 'conf/gcp.config'
    }
    azure {
        includeConfig 'conf/azure.config'
    }

    //
    // HPC profiles
    //
    slurm {
        includeConfig 'conf/slurm.config'
    }
    
    //
    // Cleanup profiles for disk space optimization
    //
    low_disk {
        // NOTE: cleanup = true deletes the work dir, so low_disk runs are NOT
        // resumable; store_clean_reads publishes the clean reads to the output
        // dir but does not act as a task cache. Filtered contigs and refined
        // bins are always published (03_assembly/, 04_binning/).
        description = 'Optimized for systems with limited disk space - enables progressive cleanup during execution'
        params {
            store_clean_reads = true
        }
        cleanup = true
        process.cache = 'lenient'
    }
}


/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Process resource definitions
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {
    // Default error strategy
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    // Clamp every process request to the --max_* params (replaces the legacy
    // check_max() function; built-in directive since Nextflow 24.04)
    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    // Process resource labels with memory and time
    withLabel:process_download {
        cpus   = 1
        memory = 2.GB
        time   = { 4.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }

    // Multi-volume database downloads (e.g. full NCBI nt): parallel fetches, long wall time
    withLabel:process_download_extensive {
        cpus   = 4
        memory = 4.GB
        time   = { 48.h * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }

    withLabel:process_single {
        cpus   = 1
        memory = { 4.GB * task.attempt }
        time   = { 4.h * task.attempt }
    }

    withLabel:process_low {
        cpus   = 4
        memory = { 12.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }

    withLabel:process_medium {
        cpus   = 8
        memory = { 36.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    withLabel:process_high {
        cpus   = 16
        memory = { 72.GB * task.attempt }
        time   = { 72.h * task.attempt }
    }

    withLabel:process_long {
        time   = { 120.h * task.attempt }
    }

    withLabel:process_high_memory {
        memory = { 256.GB * task.attempt }
    }

    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }

    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 3
    }
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Execution reports and tracing
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

// Gated on params.output: with it unset (e.g. --help runs) the eager
// "${params.output}" interpolation would create a literal "null/" directory
timeline {
    enabled = params.output as boolean
    file    = "${params.output}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = params.output as boolean
    file    = "${params.output}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = params.output as boolean
    file    = "${params.output}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = params.output as boolean
    file    = "${params.output}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.svg"
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Load config files
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

includeConfig 'config/databases.config'
includeConfig 'config/modules.config'

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'
