/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SLURM HPC Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for running BugBuster on SLURM-managed HPC clusters

    Use as follows:
        nextflow run main.nf -profile slurm,singularity --output /path/to/results

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'SLURM HPC'
    config_profile_description = 'SLURM cluster execution with Singularity containers'
}

process {
    executor = 'slurm'
    
    // Default queue/partition
    queue = params.slurm_queue ?: 'normal'
    
    // Account for job submission (if required)
    clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : ''
    
    // Partition per resource label. Times come from the labels in
    // nextflow.config (4 / 8 / 24 / 72 h, times the attempt): a fixed time here
    // would not grow when a task is retried after hitting its limit
    withLabel: 'process_single' {
        queue = params.slurm_queue_short ?: params.slurm_queue ?: 'normal'
    }
    withLabel: 'process_low' {
        queue = params.slurm_queue_short ?: params.slurm_queue ?: 'normal'
    }
    withLabel: 'process_medium' {
        queue = params.slurm_queue ?: 'normal'
    }
    withLabel: 'process_high' {
        queue = params.slurm_queue_long ?: params.slurm_queue ?: 'normal'
    }

    // Error handling: nextflow.config's rule (with the terminate-on-unschedulable
    // prefix, which never fires off the local executor)
    maxRetries    = 2
}

executor {
    name            = 'slurm'
    // as Integer: a command-line value is a String on Nextflow >= 26.04
    queueSize       = (params.slurm_queue_size ?: 100) as Integer
    submitRateLimit = '10 sec'
    pollInterval    = '30 sec'
    
    // Exit status for completed jobs
    exitReadTimeout = '10 min'
}

// Singularity settings for HPC
singularity {
    enabled    = true
    autoMounts = true
    
    // Cache directory for container images
    cacheDir   = params.singularity_cache ?: "${System.getenv('HOME') ?: '/tmp'}/.singularity/cache"
    
    // Pull timeout for large images
    pullTimeout = '60 min'
    
    // Run options
    runOptions = params.singularity_run_options ?: ''
}

// Same settings for -profile apptainer, which must come after slurm
// (`-profile slurm,apptainer`): that profile turns the singularity engine above
// off; `apptainer,slurm` enables both and Nextflow refuses to start
apptainer {
    autoMounts  = true
    cacheDir    = params.singularity_cache ?: "${System.getenv('HOME') ?: '/tmp'}/.singularity/cache"
    pullTimeout = '60 min'
    runOptions  = params.singularity_run_options ?: ''
}

// Environment modules (if needed)
// env {
//     PATH = "/path/to/tools:\$PATH"
// }
