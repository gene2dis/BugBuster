/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run main.nf -profile test,docker --output <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '6.h'

    // Input data for test (uses nf-core test datasets)
    input  = "${projectDir}/assets/test_samplesheet.csv"
    output = 'test_results'

    // Tiny decontamination references so the test never downloads the 4.1 GB
    // default host database; the combined bowtie2 index builds in seconds
    custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
    custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"

    // Minimal pipeline run settings
    quality_control           = true
    assembly_mode             = 'none'
    taxonomic_profiler        = 'none'
    include_binning           = false
    read_arg_prediction       = false
    contig_tax_and_arg        = false
    contig_level_metacerberus = false
    contig_level_functional   = false
    arg_bin_clustering        = false
}
