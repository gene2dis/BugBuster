/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BugBuster Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {
    // Default publish mode
    publishDir = [
        path: { "${params.output}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // Cache strategy: 'lenient' matches task inputs by path and size only,
    // so resume tolerates the internal cleanup steps that touch files inside
    // completed task dirs. It does NOT survive work-dir deletion.
    cache = 'lenient'

    // Capture exit codes from upstream processes when piping
    shell = ['/bin/bash', '-euo', 'pipefail']

    // Set default container options. Under singularity/apptainer every task
    // has its own PID namespace but shares the host /tmp, so a process whose
    // tool names temp files by PID sets ext.tmpdir_in_task (config/modules.config)
    // to get TMPDIR = its task dir. $PWD is expanded by the launcher, after any
    // cd to scratch; --env (Singularity >= 3.6, Apptainer) wins over the TMPDIR
    // the launcher forwards from the host (roadmap Phase 13)
    containerOptions = {
        workflow.containerEngine in ['singularity', 'apptainer']
            ? '-B /tmp:/tmp' + (task.ext.tmpdir_in_task ? ' --env TMPDIR=$PWD' : '')
            : ''
    }
}

// Executor settings for local execution. The pool is copied from the max_*
// params when the config is parsed (executor settings cannot be closures), so
// it follows --max_* on the command line or in -params-file, but NOT max_* set
// in a -c config file: such a file must also set executor.cpus/memory, or a
// task whose request exceeds the pool fails with "Process requirement exceeds
// available CPUs/memory" (design doc Q22)
executor {
    name = 'local'
    cpus = params.max_cpus
    memory = params.max_memory
    queueSize = params.max_cpus  // Match CPU count to prevent oversubscription
}
