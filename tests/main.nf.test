/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pipeline-level tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow_pipeline {

    name "Test BugBuster Pipeline"
    script "../main.nf"

    test("Run with test profile - QC only") {
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                // Tiny decontamination references so the test never downloads
                // the multi-GB default host database
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // The QC summary must be published with both test samples in it
            def reads_report = path("${outputDir}/01_quality_control/summary/Reads_report.csv")
            assert reads_report.exists()
            def report_text = reads_report.text
            assert report_text.contains("Id")
            assert report_text.contains("test_sample1")
            assert report_text.contains("test_sample2")
        }
    }

    test("QC processes singleton reads end-to-end") {
        // Regression test for audit items #2, #9, #16:
        // - #9: the singleton (s) column must survive QC (single-end fastp ->
        //   decontamination -> emitted clean reads), not be silently dropped
        // - #2: exact clean-read counts require host reads to actually map
        //   (bowtie2 --local); without it nothing is removed and counts differ
        // - #16: store_clean_reads publishes clean reads via publishDir
        // Fixtures are generated by tests/bin/make_singleton_fixtures.py:
        // 10 pairs (4 host-derived) + 10 singletons (6 host-derived).
        when {
            params {
                input = {
                    def sheet = new File("${outputDir}", "singleton_samplesheet.csv")
                    sheet.parentFile.mkdirs()
                    def reads_dir = "${projectDir}/tests/data/reads"
                    sheet.text = "sample,r1,r2,s\n" +
                        "singleton_test,${reads_dir}/singleton_test_R1.fastq.gz," +
                        "${reads_dir}/singleton_test_R2.fastq.gz," +
                        "${reads_dir}/singleton_test_S.fastq.gz\n"
                    sheet.absolutePath
                }()
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                store_clean_reads = true
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // Clean reads published via publishDir (store_clean_reads)
            def clean_dir = "${outputDir}/clean_reads/singleton_test"
            def r1_clean = path("${clean_dir}/singleton_test_R1_clean.fastq.gz")
            def r2_clean = path("${clean_dir}/singleton_test_R2_clean.fastq.gz")
            def s_clean  = path("${clean_dir}/singleton_test_Singleton_clean.fastq.gz")
            assert r1_clean.exists()
            assert r2_clean.exists()
            assert s_clean.exists()

            // Exact counts: 6 of 10 pairs and 4 of 10 singletons are non-host
            assert r1_clean.linesGzip.size() == 6 * 4
            assert r2_clean.linesGzip.size() == 6 * 4
            assert s_clean.linesGzip.size() == 4 * 4

            // The summary must carry the singleton accounting columns
            def report_text = path("${outputDir}/01_quality_control/summary/Reads_report.csv").text
            assert report_text.contains("singleton_test")
            assert report_text.toLowerCase().contains("singleton")
        }
    }

    test("Run with stub mode") {
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // Stub run must actually execute the QC path, not silently skip it
            assert workflow.trace.succeeded().size() > 0
            assert workflow.trace.tasks().any { task -> task.name.contains("FASTP") }
            assert workflow.trace.tasks().any { task -> task.name.contains("QFILTER") }
        }
    }
}
