/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pipeline-level tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow_pipeline {

    name "Test BugBuster Pipeline"
    script "../main.nf"

    test("Run with test profile - QC only") {
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                // Tiny decontamination references so the test never downloads
                // the multi-GB default host database
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // The QC summary must be published with both test samples in it
            def reads_report = path("${outputDir}/01_quality_control/summary/Reads_report.csv")
            assert reads_report.exists()
            def report_text = reads_report.text
            assert report_text.contains("Id")
            assert report_text.contains("test_sample1")
            assert report_text.contains("test_sample2")

            // Audit #14: fastp must actually receive the documented
            // --qualified_quality_phred knob (fastp records its command line
            // in the published JSON report)
            def fastp_json = path("${outputDir}/01_quality_control/fastp/test_sample1/test_sample1.fastp.json")
            assert fastp_json.exists()
            assert fastp_json.text.contains("--qualified_quality_phred 20")
        }
    }

    test("QC processes singleton reads end-to-end") {
        // Regression test for audit items #2, #9, #16:
        // - #9: the singleton (s) column must survive QC (single-end fastp ->
        //   decontamination -> emitted clean reads), not be silently dropped
        // - #2: exact clean-read counts require host reads to actually map
        //   (bowtie2 --local); without it nothing is removed and counts differ
        // - #16: store_clean_reads publishes clean reads via publishDir
        // Fixtures are generated by tests/bin/make_singleton_fixtures.py:
        // 10 pairs (4 host-derived) + 10 singletons (6 host-derived).
        when {
            params {
                input = {
                    def sheet = new File("${outputDir}", "singleton_samplesheet.csv")
                    sheet.parentFile.mkdirs()
                    def reads_dir = "${projectDir}/tests/data/reads"
                    sheet.text = "sample,r1,r2,s\n" +
                        "singleton_test,${reads_dir}/singleton_test_R1.fastq.gz," +
                        "${reads_dir}/singleton_test_R2.fastq.gz," +
                        "${reads_dir}/singleton_test_S.fastq.gz\n"
                    sheet.absolutePath
                }()
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                store_clean_reads = true
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // Clean reads published via publishDir (store_clean_reads)
            def clean_dir = "${outputDir}/clean_reads/singleton_test"
            def r1_clean = path("${clean_dir}/singleton_test_R1_clean.fastq.gz")
            def r2_clean = path("${clean_dir}/singleton_test_R2_clean.fastq.gz")
            def s_clean  = path("${clean_dir}/singleton_test_Singleton_clean.fastq.gz")
            assert r1_clean.exists()
            assert r2_clean.exists()
            assert s_clean.exists()

            // Exact counts: 6 of 10 pairs and 4 of 10 singletons are non-host
            assert r1_clean.linesGzip.size() == 6 * 4
            assert r2_clean.linesGzip.size() == 6 * 4
            assert s_clean.linesGzip.size() == 4 * 4

            // The summary must carry the singleton accounting columns
            def report_text = path("${outputDir}/01_quality_control/summary/Reads_report.csv").text
            assert report_text.contains("singleton_test")
            assert report_text.toLowerCase().contains("singleton")

            // Audit #14: the FASTP_SINGLETON selector must carry the knob too
            def singleton_json = path("${outputDir}/01_quality_control/fastp/singleton_test/singleton_test_Singleton.fastp.json")
            assert singleton_json.exists()
            assert singleton_json.text.contains("--qualified_quality_phred 20")
        }
    }

    test("Stub run publishes assembly and binning outputs") {
        // Pins the config-side publishing for BBMAP and METAWRAP
        // (config/modules.config withName blocks): their outputs must land in
        // the numbered layout. Guards the removal of the dead module-level
        // publishDir mode 'move' blocks (audit #23) and any future selector
        // rename that would silently stop publishing.
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "assembly"
                include_binning    = true
                binners            = "semibin,metabat2"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { task -> task.name.contains("BBMAP") }
            assert workflow.trace.tasks().any { task -> task.name.contains("METAWRAP") }

            // BBMAP outputs published to the numbered assembly layout
            assert path("${outputDir}/03_assembly/per_sample/test_sample1/test_sample1_filtered_contigs.fa").exists()
            assert path("${outputDir}/03_assembly/per_sample/test_sample1/test_sample1_contig.stats").exists()

            // METAWRAP refined bins published to the numbered binning layout
            assert path("${outputDir}/04_binning/per_sample/test_sample1/refined_bins/test_sample1_metawrap_50_10_bins").exists()

            // Audit #14: the single METABAT2 selector must deliver the FULL
            // arg set; the previously winning selector dropped these three.
            // The stub records its resolved ext.args into the bins dir.
            def metabat_args = path("${outputDir}/04_binning/per_sample/test_sample1/raw_bins/metabat2/test_sample1_metabat_bins/metabat2_args.txt")
            assert metabat_args.exists()
            def args_text = metabat_args.text
            assert args_text.contains("--pTNF 0")
            assert args_text.contains("--minCV 1")
            assert args_text.contains("--minCVSum 1")
            assert args_text.contains("--minContig 2500")

            // Audit #27: assembly/binning stage versions reach the aggregate
            def vtext = path("${outputDir}/pipeline_info/software_versions.yml").text
            assert vtext.contains("megahit:")
            assert vtext.contains("metabat2:")
            // Pins the GTDB-Tk container/stub version bump in lockstep
            assert vtext.contains("gtdbtk: 2.7.2")

            // T7 off-path: binning with 2 binners but WITHOUT
            // --mag_level_functional must run no Bakta and publish no mags/
            assert workflow.trace.tasks().count { task -> task.name.contains("BAKTA") } == 0
            assert !path("${outputDir}/07_functional_annotation/mags").exists()
        }
    }

    test("Stub run wires the contig-level tax/ARG path") {
        // Regression test for audit items #5 and #23:
        // - #5: ARG_BLOBPLOT(ch_arg_contig_data) passed ARG_CONTIG_LEVEL_REPORT's
        //   two output channels to a one-input process -> composition error that
        //   killed every --contig_tax_and_arg run at startup. Success here means
        //   the wiring composes.
        // - #23: DEEPARG_CONTIGS results and the contig filtering summary must
        //   be published into the documented layout (previously delivered nowhere).
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "assembly"
                taxonomic_profiler = "none"
                contig_tax_and_arg = true
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { task -> task.name.contains("DEEPARG_CONTIGS") }
            assert workflow.trace.tasks().any { task -> task.name.contains("ARG_CONTIG_LEVEL_REPORT") }
            assert workflow.trace.tasks().any { task -> task.name.contains("ARG_BLOBPLOT") }

            // DeepARG contig predictions published to the documented layout (audit #23)
            assert path("${outputDir}/05_arg_prediction/contig_level/deeparg/test_sample1/test_sample1_contigs_deep_arg.out.mapping.ARG").exists()
            assert path("${outputDir}/05_arg_prediction/contig_level/summary/Contig_tax_and_arg_prediction.tsv").exists()

            // Shared PYRODIGAL gene calling ran and its ORFs are published to
            // the documented layout (design doc Q6/Q9: gene calling moved from
            // 05_arg_prediction/contig_level/prodigal/ to
            // 07_functional_annotation/gene_calling/)
            assert workflow.trace.tasks().any { task -> task.name.contains("PYRODIGAL") }
            assert path("${outputDir}/07_functional_annotation/gene_calling/test_sample1/test_sample1.faa.gz").exists()

            // Contig filtering summary published to pipeline_info (audit #23)
            assert path("${outputDir}/pipeline_info/contig_filtering_summary.txt").exists()
        }
    }

    test("Stub run wires the contig functional annotation branch (assembly mode)") {
        // Wiring test for design doc T2/T3: eggNOG two-stage annotation plus
        // featureCounts gene quantification compose end-to-end under
        // per-sample assembly. Stub runs are exempt from the sif-only engine
        // guard, so this runs under the docker CI profile. The counting BAM
        // comes from BOWTIE2_SAMTOOLS via the gate extended with
        // contig_level_functional (Q1) - binning and contig_tax_and_arg are
        // both off here to prove the branch produces its own BAM.
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control         = true
                assembly_mode           = "assembly"
                taxonomic_profiler      = "none"
                contig_level_functional = true
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { task -> task.name.contains("BOWTIE2_SAMTOOLS") }
            assert workflow.trace.tasks().any { task -> task.name.contains("EGGNOG_MAPPER_SEARCH") }
            assert workflow.trace.tasks().any { task -> task.name.contains("EGGNOG_MAPPER_ANNOTATE") }
            // One counting task per sample, one study-level aggregation (T4),
            // one MicrobeCensus per sample (T5, on by default with the branch)
            assert workflow.trace.tasks().count { task -> task.name.contains("FEATURECOUNTS_GENES") } == 2
            assert workflow.trace.tasks().count { task -> task.name.contains("AGGREGATE_FUNCTIONS") } == 1
            assert workflow.trace.tasks().count { task -> task.name.contains("MICROBECENSUS") } == 2
            // dbCAN CAZy branch (T6, on by default with the branch): one
            // RUN_DBCAN per sample plus its database download
            assert workflow.trace.tasks().count { task -> task.name.contains("RUN_DBCAN") } == 2
            assert workflow.trace.tasks().count { task -> task.name.contains("FORMAT_DBCAN_DB") } == 1
            // COG definitions table for the COG-id -> category mapping (Q16)
            assert workflow.trace.tasks().count { task -> task.name.contains("FORMAT_COG_DB") } == 1

            // Published to the documented layout (design doc Section 9.1)
            assert path("${outputDir}/07_functional_annotation/gene_abundance/test_sample1/test_sample1.featureCounts.txt").exists()
            assert path("${outputDir}/07_functional_annotation/gene_abundance/test_sample1/test_sample1.featureCounts.txt.summary").exists()
            assert path("${outputDir}/07_functional_annotation/summary/gene_abundance.tsv").exists()
            assert path("${outputDir}/07_functional_annotation/microbecensus/test_sample1/test_sample1.ags.tsv").exists()
            assert path("${outputDir}/07_functional_annotation/summary/ags_and_ge.tsv").exists()
            assert path("${outputDir}/07_functional_annotation/dbcan/test_sample1/test_sample1.overview.tsv").exists()
        }
    }

    test("Stub run wires the contig functional annotation branch (coassembly mode)") {
        // Wiring test for design doc T3/Q1 coassembly handling: the pooled
        // binning BAM has no read groups, so the branch adds per-sample
        // alignments against the co-assembly (BOWTIE2_SAMTOOLS_PER_SAMPLE)
        // and counts each sample against the single shared co-assembly GFF.
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control         = true
                assembly_mode           = "coassembly"
                taxonomic_profiler      = "none"
                contig_level_functional = true
                // Off-switch wiring (T5): no MICROBECENSUS tasks, and the
                // aggregation must still run on an empty ags list (the
                // assembly-mode test above covers the on-path: 2 tasks)
                microbecensus           = false
                // Off-switch wiring (T6, Q13 discipline for a default-true
                // toggle): no RUN_DBCAN tasks and no dbCAN database download;
                // the aggregation must still run on an empty dbcan list (the
                // assembly-mode test above covers the on-path)
                functional_cazy         = false
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            // One per-sample alignment and one counting task per sample,
            // against the single co-assembly gene set
            assert workflow.trace.tasks().count { task -> task.name.contains("BOWTIE2_SAMTOOLS_PER_SAMPLE") } == 2
            assert workflow.trace.tasks().count { task -> task.name.contains("FEATURECOUNTS_GENES") } == 2
            assert workflow.trace.tasks().count { task -> task.name.contains("PYRODIGAL") } == 1
            assert workflow.trace.tasks().count { task -> task.name.contains("AGGREGATE_FUNCTIONS") } == 1
            assert workflow.trace.tasks().count { task -> task.name.contains("MICROBECENSUS") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("RUN_DBCAN") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("FORMAT_DBCAN_DB") } == 0
            assert !path("${outputDir}/07_functional_annotation/microbecensus").exists()
            assert !path("${outputDir}/07_functional_annotation/dbcan").exists()
            assert path("${outputDir}/07_functional_annotation/summary/ags_and_ge.tsv").exists()

            // Gene calling keyed by the coassembly meta; counts keyed per sample
            assert path("${outputDir}/07_functional_annotation/gene_calling/coassembly/coassembly.faa.gz").exists()
            assert path("${outputDir}/07_functional_annotation/gene_abundance/test_sample1/test_sample1.featureCounts.txt").exists()
            assert path("${outputDir}/07_functional_annotation/gene_abundance/test_sample2/test_sample2.featureCounts.txt").exists()
        }
    }

    test("Stub run executes bin-level ARG clustering without contig_tax_and_arg") {
        // Regression test for audit item #15: --arg_bin_clustering used to be a
        // silent no-op unless contig_tax_and_arg was also set, because only the
        // latter populated the DeepARG DB channel (.combine(empty) -> processes
        // never ran, run still "succeeded").
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "assembly"
                taxonomic_profiler = "none"
                include_binning    = true
                binners            = "semibin,metabat2"
                arg_bin_clustering = true
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { task -> task.name.contains("DEEPARG_BINS") }
            assert workflow.trace.tasks().any { task -> task.name.contains("ARG_FASTA_FORMATTER") }
            assert workflow.trace.tasks().any { task -> task.name.contains("CLUSTERING") }
        }
    }

    test("Stub run wires the read-level KARGA/KARGVA/ARGs-OAP path") {
        // First test coverage of --read_arg_prediction (added with audit #18's
        // KARGVA heap / KARGA containerOptions fixes): pins that the
        // ARGS_OAP + KARGVA -> KARGA -> ARG_NORM_REPORT chain composes and
        // the mapped-genes reports publish to the documented layout.
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control     = true
                assembly_mode       = "none"
                taxonomic_profiler  = "none"
                read_arg_prediction = true
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { task -> task.name.contains("ARGS_OAP") }
            assert workflow.trace.tasks().any { task -> task.name.contains("KARGVA") }
            assert workflow.trace.tasks().any { task -> task.name.contains("KARGA") }
            assert workflow.trace.tasks().any { task -> task.name.contains("ARG_NORM_REPORT") }

            assert path("${outputDir}/05_arg_prediction/read_level/karga/test_sample1_all_reads_KARGA_mappedGenes.csv").exists()
            assert path("${outputDir}/05_arg_prediction/read_level/kargva/test_sample1_all_reads_KARGVA_mappedGenes.csv").exists()
        }
    }

    test("Stub run wires the read-level RGI path") {
        // Regression test for audit items #8 and #17:
        // - #8: the RGI_BWT bam emit became optional (the low-coverage fallback
        //   creates no BAM and RGI_KMER is skipped for such samples). Success
        //   here pins that the RGI_BWT -> RGI_KMER -> RGI_REPORT chain still
        //   composes and publishes when alignments exist (the stub emits a bam
        //   like a real mapping run).
        // - #17: RGI_KMER's output globs hardcoded 61 while the command (and
        //   its stub) name files from params.rgi_kmer_size — a non-default k
        //   died with MissingFileException. Running with k=51 pins the
        //   parameterized globs.
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                rgi_prediction     = true
                rgi_kmer_size      = 51
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { task -> task.name.contains("RGI_BWT") }
            assert workflow.trace.tasks().any { task -> task.name.contains("RGI_KMER") }
            assert workflow.trace.tasks().any { task -> task.name.contains("RGI_REPORT") }

            // RGI outputs published to the documented read-level layout, with
            // the kmer analysis named from the non-default k (audit #17)
            assert path("${outputDir}/05_arg_prediction/read_level/rgi/test_sample1/test_sample1_rgi_bwt.gene_mapping_data.txt").exists()
            assert path("${outputDir}/05_arg_prediction/read_level/rgi/test_sample1/test_sample1_rgi_bwt.reference_mapping_stats.txt").exists()
            assert path("${outputDir}/05_arg_prediction/read_level/rgi_kmer/test_sample1/test_sample1_rgi_kmer_51mer_analysis.json").exists()
            assert path("${outputDir}/05_arg_prediction/read_level/rgi_summary/RGI_summary_report.csv").exists()
        }
    }

    test("Rejects samplesheet where r1 and r2 are the same file") {
        tag "samplesheet_validation"
        // Samplesheet-content validation (deferred from audit #15): a
        // copy-paste mistake previously ran "successfully" on duplicate mates
        when {
            params {
                input = {
                    def sheet = new File("${outputDir}", "dup_mates_samplesheet.csv")
                    sheet.parentFile.mkdirs()
                    def r1 = "${projectDir}/tests/data/reads/singleton_test_R1.fastq.gz"
                    sheet.text = "sample,r1,r2,s\ndup_test,${r1},${r1},\n"
                    sheet.absolutePath
                }()
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains("r1 and r2 are the same file") } ||
                   workflow.stderr.any { line -> line.contains("r1 and r2 are the same file") }
        }
    }

    test("Rejects path-hostile sample names") {
        tag "samplesheet_validation"
        // Sample ids become file/directory names; previously only whitespace
        // was rejected (deferred from audit #15)
        when {
            params {
                input = {
                    def sheet = new File("${outputDir}", "bad_name_samplesheet.csv")
                    sheet.parentFile.mkdirs()
                    def reads_dir = "${projectDir}/tests/data/reads"
                    sheet.text = "sample,r1,r2,s\nbad/sample,${reads_dir}/singleton_test_R1.fastq.gz,${reads_dir}/singleton_test_R2.fastq.gz,\n"
                    sheet.absolutePath
                }()
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains("Invalid sample name") } ||
                   workflow.stderr.any { line -> line.contains("Invalid sample name") }
        }
    }

    test("Rejects a header-only samplesheet") {
        tag "samplesheet_validation"
        // Previously a samplesheet with no sample rows yielded a "successful"
        // run that processed nothing (deferred from audit #15)
        when {
            params {
                input = {
                    def sheet = new File("${outputDir}", "empty_samplesheet.csv")
                    sheet.parentFile.mkdirs()
                    sheet.text = "sample,r1,r2,s\n"
                    sheet.absolutePath
                }()
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
            }
        }

        then {
            assert workflow.failed
            assert workflow.stdout.any { line -> line.contains("contains no samples") } ||
                   workflow.stderr.any { line -> line.contains("contains no samples") }
        }
    }

    test("Rejects an invalid assembly_mode value") {
        // Regression test for audit items #15/#25: a typo in assembly_mode used
        // to yield a "successful" QC-only run instead of an error. Now rejected
        // by nf-schema's enum validation (message-agnostic assertion: nf-schema
        // wording changes between plugin versions).
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                assembly_mode = "asembly"
            }
        }

        then {
            assert workflow.failed
            def console_out = (workflow.stdout + workflow.stderr).join('\n')
            assert console_out.contains("assembly_mode")
        }
    }

    test("Rejects a wrong-typed parameter via nf-schema") {
        // Regression test for audit item #25: nextflow_schema.json used to be
        // decorative (nothing validated against it). A type violation must now
        // fail the run and name the offending parameter.
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                metabat_maxP = "notanumber"
            }
        }

        then {
            assert workflow.failed
            def console_out = (workflow.stdout + workflow.stderr).join('\n')
            assert console_out.contains("metabat_maxP")
        }
    }

    test("Stub run wires the MAG functional annotation branch") {
        // T7: --mag_level_functional alone (contig branch unset) must run
        // Bakta once per refined bin and nothing of the contig branch —
        // pins the branch independence (design doc Section 7) and the
        // contig-off emit plumbing in functional_annotation.nf.
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control      = true
                assembly_mode        = "assembly"
                include_binning      = true
                binners              = "semibin,metabat2"
                mag_level_functional = true
                taxonomic_profiler   = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // Per-bin fan-out: 2 samples x 2 MetaWRAP stub bins = 4 tasks
            assert workflow.trace.tasks().count { task -> task.name.contains("BAKTA_BAKTA") } == 4
            assert workflow.trace.tasks().count { task -> task.name.contains("FORMAT_BAKTA_DB") } == 1

            // Contig branch fully off: none of its processes or databases run
            assert workflow.trace.tasks().count { task -> task.name.contains("PYRODIGAL") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("EGGNOG_MAPPER_SEARCH") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("EGGNOG_MAPPER_ANNOTATE") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("RUN_DBCAN") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("FEATURECOUNTS_GENES") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("AGGREGATE_FUNCTIONS") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("MICROBECENSUS") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("FORMAT_EGGNOG_DB") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("FORMAT_DBCAN_DB") } == 0
            assert workflow.trace.tasks().count { task -> task.name.contains("FORMAT_COG_DB") } == 0
            assert !path("${outputDir}/07_functional_annotation/summary").exists()

            // Per-bin outputs under mags/<sample>/ with the <sample>_<bin>
            // prefix (Section 9.1 layout + the modules.config ext.prefix)
            assert path("${outputDir}/07_functional_annotation/mags/test_sample1/test_sample1_bin.1.tsv").exists()
            assert path("${outputDir}/07_functional_annotation/mags/test_sample1/test_sample1_bin.2.gff3").exists()
            assert path("${outputDir}/07_functional_annotation/mags/test_sample2/test_sample2_bin.1.gff3").exists()

            // Provenance: the pinned container version reaches the aggregate
            def vtext = path("${outputDir}/pipeline_info/software_versions.yml").text
            assert vtext.contains("bakta: 1.12.1")
        }
    }

    test("Rejects mag_level_functional without include_binning") {
        // T7: Bakta only annotates refined bins, so the toggle is
        // contradictory without binning (same fail-fast policy as audit #15)
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                assembly_mode        = "assembly"
                mag_level_functional = true
            }
        }

        then {
            assert workflow.failed
            def console_out = (workflow.stdout + workflow.stderr).join('\n')
            assert console_out.contains("--mag_level_functional requires --include_binning")
        }
    }

    test("Rejects mag_level_functional with a single binner") {
        // T7 owner decision (2026-08-30): the only bin quality filter is
        // MetaWRAP refinement (-c/-x), which runs only with >= 2 binners;
        // Bakta must never see unfiltered single-binner output
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                assembly_mode        = "assembly"
                include_binning      = true
                binners              = "semibin"
                mag_level_functional = true
            }
        }

        then {
            assert workflow.failed
            def console_out = (workflow.stdout + workflow.stderr).join('\n')
            assert console_out.contains("--mag_level_functional requires at least two --binners")
        }
    }

    test("Rejects include_binning with assembly_mode none") {
        // Regression test for audit item #15: contradictory feature combos must
        // fail fast instead of silently skipping stages.
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                assembly_mode   = "none"
                include_binning = true
            }
        }

        then {
            assert workflow.failed
            def console_out = (workflow.stdout + workflow.stderr).join('\n')
            assert console_out.contains("--include_binning requires an assembly")
        }
    }

    test("Run with stub mode") {
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // Stub run must actually execute the QC path, not silently skip it
            assert workflow.trace.succeeded().size() > 0
            assert workflow.trace.tasks().any { task -> task.name.contains("FASTP") }
            assert workflow.trace.tasks().any { task -> task.name.contains("QFILTER") }

            // Audit #27: aggregated software versions must reach pipeline_info
            def versions = path("${outputDir}/pipeline_info/software_versions.yml")
            assert versions.exists()
            def vtext = versions.text
            assert vtext.contains('"gene2dis/BugBuster":')   // workflow block
            assert vtext.contains("fastp:")                  // nf-core module
            assert vtext.contains("bash:")                   // new QFILTER capture
            // Content-dedup: ONE block per process despite two samples
            assert vtext.count('"QC:FASTP":') == 1
        }
    }
}
