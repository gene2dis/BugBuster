/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pipeline-level tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow_pipeline {

    name "Test BugBuster Pipeline"
    script "../main.nf"

    test("Run with test profile - QC only") {
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                // Tiny decontamination references so the test never downloads
                // the multi-GB default host database
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // The QC summary must be published with both test samples in it
            def reads_report = path("${outputDir}/01_quality_control/summary/Reads_report.csv")
            assert reads_report.exists()
            def report_text = reads_report.text
            assert report_text.contains("Id")
            assert report_text.contains("test_sample1")
            assert report_text.contains("test_sample2")

            // Audit #14: fastp must actually receive the documented
            // --qualified_quality_phred knob (fastp records its command line
            // in the published JSON report)
            def fastp_json = path("${outputDir}/01_quality_control/fastp/test_sample1/test_sample1.fastp.json")
            assert fastp_json.exists()
            assert fastp_json.text.contains("--qualified_quality_phred 20")
        }
    }

    test("QC processes singleton reads end-to-end") {
        // Regression test for audit items #2, #9, #16:
        // - #9: the singleton (s) column must survive QC (single-end fastp ->
        //   decontamination -> emitted clean reads), not be silently dropped
        // - #2: exact clean-read counts require host reads to actually map
        //   (bowtie2 --local); without it nothing is removed and counts differ
        // - #16: store_clean_reads publishes clean reads via publishDir
        // Fixtures are generated by tests/bin/make_singleton_fixtures.py:
        // 10 pairs (4 host-derived) + 10 singletons (6 host-derived).
        when {
            params {
                input = {
                    def sheet = new File("${outputDir}", "singleton_samplesheet.csv")
                    sheet.parentFile.mkdirs()
                    def reads_dir = "${projectDir}/tests/data/reads"
                    sheet.text = "sample,r1,r2,s\n" +
                        "singleton_test,${reads_dir}/singleton_test_R1.fastq.gz," +
                        "${reads_dir}/singleton_test_R2.fastq.gz," +
                        "${reads_dir}/singleton_test_S.fastq.gz\n"
                    sheet.absolutePath
                }()
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                store_clean_reads = true
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // Clean reads published via publishDir (store_clean_reads)
            def clean_dir = "${outputDir}/clean_reads/singleton_test"
            def r1_clean = path("${clean_dir}/singleton_test_R1_clean.fastq.gz")
            def r2_clean = path("${clean_dir}/singleton_test_R2_clean.fastq.gz")
            def s_clean  = path("${clean_dir}/singleton_test_Singleton_clean.fastq.gz")
            assert r1_clean.exists()
            assert r2_clean.exists()
            assert s_clean.exists()

            // Exact counts: 6 of 10 pairs and 4 of 10 singletons are non-host
            assert r1_clean.linesGzip.size() == 6 * 4
            assert r2_clean.linesGzip.size() == 6 * 4
            assert s_clean.linesGzip.size() == 4 * 4

            // The summary must carry the singleton accounting columns
            def report_text = path("${outputDir}/01_quality_control/summary/Reads_report.csv").text
            assert report_text.contains("singleton_test")
            assert report_text.toLowerCase().contains("singleton")

            // Audit #14: the FASTP_SINGLETON selector must carry the knob too
            def singleton_json = path("${outputDir}/01_quality_control/fastp/singleton_test/singleton_test_Singleton.fastp.json")
            assert singleton_json.exists()
            assert singleton_json.text.contains("--qualified_quality_phred 20")
        }
    }

    test("Stub run publishes assembly and binning outputs") {
        // Pins the config-side publishing for BBMAP and METAWRAP
        // (config/modules.config withName blocks): their outputs must land in
        // the numbered layout. Guards the removal of the dead module-level
        // publishDir mode 'move' blocks (audit #23) and any future selector
        // rename that would silently stop publishing.
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "assembly"
                include_binning    = true
                binners            = "semibin,metabat2"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { task -> task.name.contains("BBMAP") }
            assert workflow.trace.tasks().any { task -> task.name.contains("METAWRAP") }

            // BBMAP outputs published to the numbered assembly layout
            assert path("${outputDir}/03_assembly/per_sample/test_sample1/test_sample1_filtered_contigs.fa").exists()
            assert path("${outputDir}/03_assembly/per_sample/test_sample1/test_sample1_contig.stats").exists()

            // METAWRAP refined bins published to the numbered binning layout
            assert path("${outputDir}/04_binning/per_sample/test_sample1/refined_bins/test_sample1_metawrap_50_10_bins").exists()

            // Audit #14: the single METABAT2 selector must deliver the FULL
            // arg set; the previously winning selector dropped these three.
            // The stub records its resolved ext.args into the bins dir.
            def metabat_args = path("${outputDir}/04_binning/per_sample/test_sample1/raw_bins/metabat2/test_sample1_metabat_bins/metabat2_args.txt")
            assert metabat_args.exists()
            def args_text = metabat_args.text
            assert args_text.contains("--pTNF 0")
            assert args_text.contains("--minCV 1")
            assert args_text.contains("--minCVSum 1")
            assert args_text.contains("--minContig 2500")

            // Audit #27: assembly/binning stage versions reach the aggregate
            def vtext = path("${outputDir}/pipeline_info/software_versions.yml").text
            assert vtext.contains("megahit:")
            assert vtext.contains("metabat2:")
        }
    }

    test("Stub run wires the contig-level tax/ARG path") {
        // Regression test for audit items #5 and #23:
        // - #5: ARG_BLOBPLOT(ch_arg_contig_data) passed ARG_CONTIG_LEVEL_REPORT's
        //   two output channels to a one-input process -> composition error that
        //   killed every --contig_tax_and_arg run at startup. Success here means
        //   the wiring composes.
        // - #23: DEEPARG_CONTIGS results and the contig filtering summary must
        //   be published into the documented layout (previously delivered nowhere).
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "assembly"
                taxonomic_profiler = "none"
                contig_tax_and_arg = true
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { task -> task.name.contains("DEEPARG_CONTIGS") }
            assert workflow.trace.tasks().any { task -> task.name.contains("ARG_CONTIG_LEVEL_REPORT") }
            assert workflow.trace.tasks().any { task -> task.name.contains("ARG_BLOBPLOT") }

            // DeepARG contig predictions published to the documented layout (audit #23)
            assert path("${outputDir}/05_arg_prediction/contig_level/deeparg/test_sample1/test_sample1_contigs_deep_arg.out.mapping.ARG").exists()
            assert path("${outputDir}/05_arg_prediction/contig_level/summary/Contig_tax_and_arg_prediction.tsv").exists()

            // Contig filtering summary published to pipeline_info (audit #23)
            assert path("${outputDir}/pipeline_info/contig_filtering_summary.txt").exists()
        }
    }

    test("Stub run executes bin-level ARG clustering without contig_tax_and_arg") {
        // Regression test for audit item #15: --arg_bin_clustering used to be a
        // silent no-op unless contig_tax_and_arg was also set, because only the
        // latter populated the DeepARG DB channel (.combine(empty) -> processes
        // never ran, run still "succeeded").
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "assembly"
                taxonomic_profiler = "none"
                include_binning    = true
                binners            = "semibin,metabat2"
                arg_bin_clustering = true
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success
            assert workflow.trace.tasks().any { task -> task.name.contains("DEEPARG_BINS") }
            assert workflow.trace.tasks().any { task -> task.name.contains("ARG_FASTA_FORMATTER") }
            assert workflow.trace.tasks().any { task -> task.name.contains("CLUSTERING") }
        }
    }

    test("Rejects an invalid assembly_mode value") {
        // Regression test for audit item #15: a typo in assembly_mode used to
        // yield a "successful" QC-only run instead of an error.
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                assembly_mode = "asembly"
            }
        }

        then {
            assert workflow.failed
            def console_out = (workflow.stdout + workflow.stderr).join('\n')
            assert console_out.contains("Invalid --assembly_mode")
        }
    }

    test("Rejects include_binning with assembly_mode none") {
        // Regression test for audit item #15: contradictory feature combos must
        // fail fast instead of silently skipping stages.
        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                assembly_mode   = "none"
                include_binning = true
            }
        }

        then {
            assert workflow.failed
            def console_out = (workflow.stdout + workflow.stderr).join('\n')
            assert console_out.contains("--include_binning requires an assembly")
        }
    }

    test("Run with stub mode") {
        options "-stub"

        when {
            params {
                input  = "${projectDir}/assets/test_samplesheet.csv"
                output = "${outputDir}"
                quality_control    = true
                assembly_mode      = "none"
                taxonomic_profiler = "none"
                custom_phiX_fasta = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                max_cpus   = 2
                max_memory = "6.GB"
            }
        }

        then {
            assert workflow.success

            // Stub run must actually execute the QC path, not silently skip it
            assert workflow.trace.succeeded().size() > 0
            assert workflow.trace.tasks().any { task -> task.name.contains("FASTP") }
            assert workflow.trace.tasks().any { task -> task.name.contains("QFILTER") }

            // Audit #27: aggregated software versions must reach pipeline_info
            def versions = path("${outputDir}/pipeline_info/software_versions.yml")
            assert versions.exists()
            def vtext = versions.text
            assert vtext.contains('"gene2dis/BugBuster":')   // workflow block
            assert vtext.contains("fastp:")                  // nf-core module
            assert vtext.contains("bash:")                   // new QFILTER capture
            // Content-dedup: ONE block per process despite two samples
            assert vtext.count('"QC:FASTP":') == 1
        }
    }
}
