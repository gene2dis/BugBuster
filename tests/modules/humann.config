// Fixture arguments for the HUMANN module nf-test (design doc T8c): no
// MetaPhlAn database in CI (--bypass-prescreen) and relaxed subject-coverage
// thresholds so the small fixture subsample yields pathways - the same
// arguments tests/bin/make_humann_fixtures.sh used to make the committed
// outputs. One CPU keeps the run identical to the committed fixture.
process {
    withName: 'HUMANN' {
        cpus = 1
        ext.args = '--bypass-prescreen --nucleotide-subject-coverage-threshold 0 --translated-subject-coverage-threshold 0'
    }
}
