/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BIN_CONTIG_TABLE Module Test

    Co-assembly bin depth counts each sample's co-assembly alignment over the
    contigs of each refined bin, through a contig -> bin table.
    tests/data/bins/overlap_bins:
      - a.fa: c1 (header with a description), c2
      - b.fa: c2 again (must be skipped, so each contig counts once)
              and c3
      - c.fa: empty bin (one table row with an empty contig field)
      - d.fa: only c1 again, so it adds no contig and gets the same
              empty-contig row (it had no row, and no depth row, before)
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow_process {

    name "Test BIN_CONTIG_TABLE Process"
    script "../../modules/local/bedtools/main.nf"
    process "BIN_CONTIG_TABLE"

    test("lists each contig once, keeps empty and fully duplicated bins") {
        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/bins/overlap_bins", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success

            def table = path(process.out.table[0]).readLines()
            assert table == ["c1\ta", "c2\ta", "c3\tb", "\tc", "\td"]
            assert path(process.out.versions.get(0)).text.contains("busybox: 1.36.1")
        }
    }

    test("real bins") {
        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/bins/real_bins", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.table[0]).readLines() == ["bin1_contig_1\tbin.1"]
        }
    }

    test("bins dir holding only a SKIPPED marker") {
        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/bins/marker_only_bins", checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assert path(process.out.table[0]).text == ''
        }
    }
}
