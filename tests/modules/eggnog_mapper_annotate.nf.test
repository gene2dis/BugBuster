/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EGGNOG_MAPPER_ANNOTATE Module Test

    Stage 2 of the two-stage eggNOG-mapper v3 run (design doc Section 4.2,
    task T2). Stub-mode only: a real run needs the ~44 GB eggNOG 7 database
    and a singularity/apptainer engine (v3 beta ships only an Apptainer
    image), neither CI-feasible. Under the suite's docker profile the module's
    container resolves to none, so the stub runs bare-metal. The Section 10.2
    acceptance check (non-empty annotations on a test protein set) is a manual
    run against a real database.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow_process {

    name "Test EGGNOG_MAPPER_ANNOTATE Process"
    script "../../modules/local/eggnog_mapper_annotate/main.nf"
    process "EGGNOG_MAPPER_ANNOTATE"

    test("stub emits annotations and versions") {
        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'stubtest' ],
                    file("${projectDir}/tests/data/bins/real_bins/bin.1.fa", checkIfExists: true),
                    file("${projectDir}/tests/data", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assert process.out.annotations.size() == 1
            assert process.out.annotations.get(0).get(1).endsWith('stubtest.emapper.annotations')
            assert process.out.versions.size() == 1
            assert path(process.out.versions.get(0)).text.contains('eggnog-mapper:')
        }
    }
}
