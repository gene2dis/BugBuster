/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AGGREGATE_FUNCTIONS Module Test

    Study-level functional aggregation (design doc Section 4.8, tasks
    T4+T5+T6). The full aggregation logic — TPM/CPGE math, intentional
    double-counting, version-aware layout guards (eggNOG and dbCAN), AGS
    guard, consensus policies, edge cases — is covered directly by
    tests/bin/test_aggregate_functions.sh; these tests verify the module
    wrapper: staging (incl. the eggnog_versions.yml/dbcan_versions.yml
    renames and the optional ags/dbcan lists), the script invocation, and
    the declared outputs, in both assembly-mode shapes.

    Fixtures: tests/data/functional/ (see tests/bin/make_functional_fixtures.sh)
    — a format-faithful eggNOG-mapper v3.0.0-beta6 annotations file plus
    featureCounts tables, a run_dbcan v5 overview, a MICROBECENSUS ags table
    and per-name GFF copies.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow_process {

    name "Test AGGREGATE_FUNCTIONS Process"
    script "../../modules/local/aggregate_functions/main.nf"
    process "AGGREGATE_FUNCTIONS"

    test("aggregates one sample under assembly mode") {
        when {
            process {
                """
                input[0] = [ file("${projectDir}/tests/data/functional/sampleA.featureCounts.txt", checkIfExists: true) ]
                input[1] = [ file("${projectDir}/tests/data/functional/sampleA.emapper.annotations", checkIfExists: true) ]
                input[2] = [ file("${projectDir}/tests/data/functional/sampleA.gff.gz", checkIfExists: true) ]
                input[3] = [ file("${projectDir}/tests/data/functional/sampleA.ags.tsv", checkIfExists: true) ]
                input[4] = [ file("${projectDir}/tests/data/functional/sampleA.overview.tsv", checkIfExists: true) ]
                input[5] = file("${projectDir}/tests/data/functional/eggnog_versions.yml", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/functional/dbcan_versions.yml", checkIfExists: true)
                input[7] = file("${projectDir}/tests/data/functional/cog-fixture.def.tab", checkIfExists: true)
                input[8] = "assembly"
                input[9] = "recommended"
                """
            }
        }

        then {
            assert process.success

            // Every predicted gene appears (2 genes), TPM sums to 1e6 (10.2)
            def abundance = path(process.out.gene_abundance.get(0)).readLines()
            assert abundance.size() == 3
            def tpm_sum = abundance.drop(1).sum { row -> row.split('\t')[5].toDouble() }
            assert Math.abs(tpm_sum - 1e6) < 0.1

            // CPGE (T5): fixture GE = 2.0 gives hand-checkable RPK/GE values
            assert abundance.any { row -> row.endsWith('750000.0000\t50.000000') }
            assert abundance.any { row -> row.endsWith('250000.0000\t16.666667') }

            // The 2-KO gene appears once per KO at full abundance, TPM and CPGE
            def functions = path(process.out.function_abundance.get(0)).text
            assert functions.contains('ko\tK00001\t\t750000.0000\t50.000000')
            assert functions.contains('ko\tK00002\t\t750000.0000\t50.000000')

            // dbCAN (T6): backend=run_dbcan rows next to the eggNOG cazy call
            assert functions.contains('run_dbcan\tcazy\tGH5_4')
            assert functions.contains('eggnog-mapper\tcazy\tGT2')

            // Q16: the COG id in COG_category maps through the COG table
            // (fixture COG0001 -> 'EG'); no id/character fragments
            assert functions.contains('eggnog-mapper\tcog\tE\t')
            assert functions.contains('eggnog-mapper\tcog\tG\t')
            assert !functions.contains('\tcog\tCOG0001\t')

            // All twelve wide matrices (tpm + cpge, incl. cazy_dbcan);
            // AGS summary; per-backend provenance versions
            assert process.out.function_wide.get(0).size() == 12
            assert process.out.function_wide.get(0).any { f -> f.contains('function_wide_cazy_dbcan_tpm') }
            assert path(process.out.ags_summary.get(0)).text.contains('sampleA\t3000000\t2.0\t6000000\tok')
            assert path(process.out.gene_annotations.get(0)).text.contains('3.0.0-beta6\t7.0.0')
            assert path(process.out.gene_annotations.get(0)).text.contains('run_dbcan\t5.2.9\tdb_v5-2-9_5-5-2026')
            assert path(process.out.versions.get(0)).text.contains('pandas:')
        }
    }

    test("aggregates per-sample counts against a shared co-assembly gene set") {
        when {
            process {
                """
                input[0] = [
                    file("${projectDir}/tests/data/functional/sampleA.featureCounts.txt", checkIfExists: true),
                    file("${projectDir}/tests/data/functional/sampleB.featureCounts.txt", checkIfExists: true)
                ]
                input[1] = [ file("${projectDir}/tests/data/functional/coassembly.emapper.annotations", checkIfExists: true) ]
                input[2] = [ file("${projectDir}/tests/data/functional/coassembly.gff.gz", checkIfExists: true) ]
                input[3] = [ file("${projectDir}/tests/data/functional/sampleA.ags.tsv", checkIfExists: true) ]
                input[4] = [ file("${projectDir}/tests/data/functional/coassembly.overview.tsv", checkIfExists: true) ]
                input[5] = file("${projectDir}/tests/data/functional/eggnog_versions.yml", checkIfExists: true)
                input[6] = file("${projectDir}/tests/data/functional/dbcan_versions.yml", checkIfExists: true)
                input[7] = file("${projectDir}/tests/data/functional/cog-fixture.def.tab", checkIfExists: true)
                input[8] = "coassembly"
                input[9] = "recommended"
                """
            }
        }

        then {
            assert process.success

            // Per-sample abundance over the shared gene set (2 genes x 2 samples)
            def abundance = path(process.out.gene_abundance.get(0)).readLines()
            assert abundance.size() == 5
            assert abundance.drop(1).every { row -> row.split('\t')[2] == 'coassembly' }

            // AGS covers only sampleA: sampleB rows end with an empty cpge field
            assert abundance.any { row -> row.startsWith('sampleA\tcontig_1_1') && row.endsWith('\t50.000000') }
            assert abundance.any { row -> row.startsWith('sampleB\tcontig_1_2') && row.endsWith('\t') }
            assert path(process.out.ags_summary.get(0)).text.contains('sampleB\t\t\t\tunavailable')

            // 5.1 keyed by the coassembly unit, not per sample (design doc 4.8
            // record) — dbCAN rows included
            def annotation_lines = path(process.out.gene_annotations.get(0)).readLines()
            def annotation_samples = annotation_lines
                .drop(1).collect { row -> row.split('\t')[0] }.unique()
            assert annotation_samples == ['coassembly']
            assert annotation_lines.any { row -> row.contains('\tdbcan\tGH5_4\t') }

            // Wide matrices carry one column per sample
            def wide_ko = process.out.function_wide.get(0).find { f -> f.contains('function_wide_ko_tpm') }
            assert path(wide_ko).readLines()[0] == 'accession\tsampleA\tsampleB'
        }
    }

    test("stub emits all declared outputs") {
        options "-stub"

        when {
            process {
                """
                input[0] = [ file("${projectDir}/tests/data/functional/sampleA.featureCounts.txt", checkIfExists: true) ]
                input[1] = [ file("${projectDir}/tests/data/functional/sampleA.emapper.annotations", checkIfExists: true) ]
                input[2] = [ file("${projectDir}/tests/data/functional/sampleA.gff.gz", checkIfExists: true) ]
                input[3] = []
                input[4] = []
                input[5] = file("${projectDir}/tests/data/functional/eggnog_versions.yml", checkIfExists: true)
                input[6] = []
                input[7] = file("${projectDir}/tests/data/functional/cog-fixture.def.tab", checkIfExists: true)
                input[8] = "assembly"
                input[9] = "recommended"
                """
            }
        }

        then {
            assert process.success
            assert process.out.gene_annotations.size() == 1
            assert process.out.gene_abundance.size() == 1
            assert process.out.function_abundance.size() == 1
            assert process.out.function_wide.get(0).size() == 12
            assert process.out.annotated_fraction.size() == 1
            assert process.out.ags_summary.size() == 1
            assert process.out.versions.size() == 1
        }
    }
}
