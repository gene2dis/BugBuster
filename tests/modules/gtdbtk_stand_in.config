// GTDB_TK_BATCH with tests/modules/gtdbtk_stand_in.sh in place of the image's
// gtdbtk (docker only, as nf-test runs; replaces conf/base.config's
// containerOptions, which are empty under docker)
process {
    withName: 'GTDB_TK_BATCH' {
        containerOptions = "-v ${projectDir}/tests/modules/gtdbtk_stand_in.sh:/usr/local/bin/gtdbtk:ro"
    }
}
