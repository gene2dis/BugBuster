// Builds the tiny test index as a large (.bt2l) index, as bowtie2-build does
// on its own for references over ~4 Gbp (several host genomes), so the
// BOWTIE2_DECONTAMINATE test covers the .bt2l basename
process {
    withName: 'BOWTIE2_BUILD_COMBINED' {
        ext.args = '--large-index'
    }
}
