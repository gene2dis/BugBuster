/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Co-assembly per metadata group (--coassembly_group_by, roadmap Phase 15, A4)

    - Without the param a co-assembly run publishes exactly the paths dev did
      before the change (tests/data/stub_paths/coassembly_dev.txt: a stub run
      of dev 3d1090e with the settings below).
    - With it, one co-assembly per group, here two groups one of which has a
      single sample, each under <stage>/coassembly/<group>/.
    - One launch-time error per misuse of the param, its table or its labels.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

nextflow_pipeline {

    name "Co-assembly per metadata group"
    script "../main.nf"

    test("Ungrouped co-assembly stub publishes the same paths as before the groups") {
        options "-stub"

        when {
            params {
                input  = TestData.localSamplesheet(outputDir, projectDir)
                output = "${outputDir}"
                quality_control         = true
                custom_phiX_fasta       = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta       = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                assembly_mode           = "coassembly"
                taxonomic_profiler      = "none"
                include_binning         = true
                binners                 = "semibin,metabat2"
                contig_tax_and_arg      = true
                genomad_prediction      = true
                arg_bin_clustering      = true
                contig_level_functional = true
                mag_level_functional    = true
                microbecensus           = true
                results_summary         = true
                max_cpus   = 4
                max_memory = "8.GB"
            }
        }

        then {
            assert workflow.success
            def out = new File("${outputDir}")
            def published = []
            out.eachFileRecurse { f ->
                if (f.isFile()) {
                    def rel = out.toPath().relativize(f.toPath()).toString()
                    if (!(rel ==~ /pipeline_info\/(execution_|pipeline_dag|params_).*/) && !rel.startsWith('local_test_samplesheet')) {
                        published << rel
                    }
                }
            }
            def expected = new File("${projectDir}/tests/data/stub_paths/coassembly_dev.txt").readLines()
            assert published.sort() == expected.sort()
        }
    }

    test("Stub run with two co-assembly groups, one of a single sample") {
        // 'group A' (test_sample1, test_sample2) becomes group_A; 'solo'
        // (test_sample3) is a one-sample co-assembly. A row for a sample not
        // in the run is ignored
        options "-stub"

        when {
            params {
                input  = TestData.localSamplesheet3(outputDir, projectDir)
                output = "${outputDir}"
                sample_metadata         = TestData.metadataTable(outputDir, "groups.tsv",
                    "sample\tsite\nother_batch\tgroup A\ntest_sample1\tgroup A\ntest_sample2\tgroup A\ntest_sample3\tsolo\n")
                coassembly_group_by     = "site"
                quality_control         = true
                custom_phiX_fasta       = "${projectDir}/tests/data/decontamination/phiX174.fasta"
                custom_host_fasta       = "${projectDir}/tests/data/decontamination/host_mock.fasta"
                assembly_mode           = "coassembly"
                taxonomic_profiler      = "none"
                include_binning         = true
                binners                 = "semibin,metabat2"
                contig_tax_and_arg      = true
                genomad_prediction      = true
                arg_bin_clustering      = true
                contig_level_functional = true
                mag_level_functional    = true
                microbecensus           = true
                results_summary         = true
                max_cpus   = 4
                max_memory = "8.GB"
            }
        }

        then {
            assert workflow.success
            def count = { name -> workflow.trace.tasks().count { task -> task.name.startsWith(name) } }
            // per group: assembly, index, merge, depth, bin summary
            assert count("ASSEMBLY:MEGAHIT (") == 2
            assert count("ASSEMBLY:BWAMEM3_INDEX (") == 2
            assert count("ASSEMBLY:BWAMEM3_SAMTOOLS (") == 3
            assert count("ASSEMBLY:NFCORE_SAMTOOLS_MERGE (") == 2
            assert count("BINNING:CALCULATE_DEPTH (") == 2
            assert count("BINNING:BIN_DEPTH (") == 2
            assert count("BINNING:BIN_SUMMARY (") == 2
            assert count("BINNING:BINETTE (") == 2
            assert count("FUNCTIONAL_ANNOTATION:FEATURECOUNTS_GENES (") == 3
            assert count("FUNCTIONAL_ANNOTATION:EGGNOG_MAPPER_SEARCH (") == 2

            def o = "${outputDir}"
            assert path("${o}/pipeline_info/coassembly_groups.tsv").readLines() ==
                ["sample\tgroup", "test_sample1\tgroup_A", "test_sample2\tgroup_A", "test_sample3\tsolo"]
            for (g in ["group_A", "solo"]) {
                assert path("${o}/03_assembly/coassembly/${g}/${g}_filtered_contigs.fa").exists()
                assert path("${o}/03_assembly/coassembly/${g}/${g}_contig.stats").exists()
                assert path("${o}/04_binning/coassembly/${g}/refined_bins/${g}_binette_bins").exists()
                assert path("${o}/04_binning/coassembly/${g}/raw_bins/metabat2/${g}_metabat_bins").exists()
                assert path("${o}/04_binning/coassembly/${g}/quality/checkm2/${g}_binette_quality_report.tsv").exists()
                assert path("${o}/04_binning/coassembly/${g}/taxonomy/gtdbtk/${g}_gtdbtk_bac120.tsv").exists()
                assert path("${o}/04_binning/coassembly/${g}/summary/Bin_summary.csv").exists()
                assert path("${o}/05_arg_prediction/contig_level/deeparg/coassembly/${g}/${g}_contigs_deep_arg.out.mapping.ARG").exists()
                assert path("${o}/06_contig_taxonomy/metabuli/coassembly/${g}").exists()
                assert path("${o}/06_contig_taxonomy/genomad/coassembly/${g}").exists()
                assert path("${o}/07_functional_annotation/gene_calling/coassembly/${g}/${g}.faa.gz").exists()
                assert path("${o}/07_functional_annotation/eggnog/coassembly/${g}").exists()
                assert path("${o}/07_functional_annotation/mags/coassembly/${g}/${g}_binette_bin1.tsv").exists()
            }
            // each sample's depth sits with its own group's bins
            assert path("${o}/04_binning/coassembly/group_A/coverage/test_sample1_bin_depth.tsv").exists()
            assert path("${o}/04_binning/coassembly/group_A/coverage/test_sample2_bin_depth.tsv").exists()
            assert path("${o}/04_binning/coassembly/solo/coverage/test_sample3_bin_depth.tsv").exists()
            assert !path("${o}/04_binning/coassembly/solo/coverage/test_sample1_bin_depth.tsv").exists()
            // nothing published for an ungrouped co-assembly
            assert !path("${o}/03_assembly/coassembly/coassembly_contigs.fa").exists()
            assert !path("${o}/04_binning/coassembly/refined_bins").exists()
            assert !path("${o}/05_arg_prediction/contig_level/deeparg/coassembly/coassembly_contigs_deep_arg.out.mapping.ARG").exists()
            // per-sample outputs stay per sample
            assert path("${o}/07_functional_annotation/gene_abundance/test_sample3").exists()
            // the launch log lists the groups
            assert path("${outputDir}/../meta/nextflow.log").text.contains("Co-assembly groups   : 2 by site (group_A: 2, solo: 1)")
        }
    }

    test("Rejects --coassembly_group_by without --assembly_mode coassembly") {
        when {
            params {
                input  = TestData.localSamplesheet(outputDir, projectDir)
                output = "${outputDir}"
                assembly_mode       = "assembly"
                sample_metadata     = TestData.metadataTable(outputDir, "m.tsv", "sample\tsite\ntest_sample1\ta\ntest_sample2\tb\n")
                coassembly_group_by = "site"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("--coassembly_group_by site groups the samples of a co-assembly, but --assembly_mode is 'assembly'")
        }
    }

    test("Rejects --coassembly_group_by without --sample_metadata") {
        when {
            params {
                input  = TestData.localSamplesheet(outputDir, projectDir)
                output = "${outputDir}"
                assembly_mode       = "coassembly"
                coassembly_group_by = "site"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("--coassembly_group_by site names a column of --sample_metadata")
        }
    }

    test("Rejects a --coassembly_group_by column the table lacks") {
        when {
            params {
                input  = TestData.localSamplesheet(outputDir, projectDir)
                output = "${outputDir}"
                assembly_mode       = "coassembly"
                sample_metadata     = TestData.metadataTable(outputDir, "m.csv", "sample,subject\ntest_sample1,a\ntest_sample2,b\n")
                coassembly_group_by = "site"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("has no such column (columns: subject)")
        }
    }

    test("Rejects samples without a metadata row") {
        when {
            params {
                input  = TestData.localSamplesheet3(outputDir, projectDir)
                output = "${outputDir}"
                assembly_mode       = "coassembly"
                sample_metadata     = TestData.metadataTable(outputDir, "m.tsv", "sample\tsite\ntest_sample1\ta\n")
                coassembly_group_by = "site"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("no --sample_metadata row for sample(s) test_sample2, test_sample3")
        }
    }

    test("Rejects samples with a blank group value") {
        // sample names in the first column, as the summary reads it
        when {
            params {
                input  = TestData.localSamplesheet(outputDir, projectDir)
                output = "${outputDir}"
                assembly_mode       = "coassembly"
                sample_metadata     = TestData.metadataTable(outputDir, "m.tsv", "id\tsite\ntest_sample1\ta\ntest_sample2\t  \n")
                coassembly_group_by = "site"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("no value in column site for sample(s) test_sample2")
        }
    }

    test("Rejects two group values that give the same label") {
        when {
            params {
                input  = TestData.localSamplesheet(outputDir, projectDir)
                output = "${outputDir}"
                assembly_mode       = "coassembly"
                sample_metadata     = TestData.metadataTable(outputDir, "m.tsv", "sample\tsite\ntest_sample1\tsite 1\ntest_sample2\tsite/1\n")
                coassembly_group_by = "site"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("'site 1' and 'site/1' both become 'site_1'")
        }
    }

    test("Rejects a group label that is a sample id") {
        when {
            params {
                input  = TestData.localSamplesheet(outputDir, projectDir)
                output = "${outputDir}"
                assembly_mode       = "coassembly"
                sample_metadata     = TestData.metadataTable(outputDir, "m.tsv", "sample\tsite\ntest_sample1\ttest_sample2\ntest_sample2\tb\n")
                coassembly_group_by = "site"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("gives the label 'test_sample2', which is also a sample id")
        }
    }

    test("Rejects the group label coassembly") {
        when {
            params {
                input  = TestData.localSamplesheet(outputDir, projectDir)
                output = "${outputDir}"
                assembly_mode       = "coassembly"
                sample_metadata     = TestData.metadataTable(outputDir, "m.tsv", "sample\tsite\ntest_sample1\tcoassembly\ntest_sample2\tb\n")
                coassembly_group_by = "site"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("gives the label 'coassembly', the name of the ungrouped co-assembly")
        }
    }

    test("Rejects a group label that does not start with a letter or digit") {
        when {
            params {
                input  = TestData.localSamplesheet(outputDir, projectDir)
                output = "${outputDir}"
                assembly_mode       = "coassembly"
                sample_metadata     = TestData.metadataTable(outputDir, "m.tsv", "sample\tsite\ntest_sample1\t.hidden\ntest_sample2\tb\n")
                coassembly_group_by = "site"
            }
        }

        then {
            assert workflow.failed
            assert (workflow.stdout + workflow.stderr).join('\n').contains("gives the label '.hidden', which does not start with a letter or digit")
        }
    }
}
